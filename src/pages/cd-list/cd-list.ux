<!-- 首页 = 倒数日列表（manifest router.entry 指向本页）
     2026-11-02 v0.3.0 视觉重做（iOS「倒数日 / Days Matter」风格）：
       1) 顶部不再是可点胶囊 —— 标题只当标题，用户不会再以为「菜单」是返回；
          设置入口改为底部常驻双按钮行（＋ 添加 / 设置），
          彻底避开胶囊屏顶部两个圆角的裁切区（192 屏 y<60 时 x<24 会被圆角吃掉）。
       2) 卡片版式从「标题 → 剩 N 天 → 进度 → 日期」四段压缩为
          「标题 → 大数字 + 单位 → 细进度 → 日期·星期」，
          天数从 26px 提到 40px 成为视觉主角 —— 这是倒数日类应用的核心信息。
       3) 每条仍用自己颜色的淡底 + 淡描边（tint），一屏内多条目可分辨。
-->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 顶栏：居中纯文字标题。故意不可点 —— 首页没有上一页，
         任何「看起来能返回」的元素出现在这里是误导（v0.2.1 之前是「菜单」胶囊）。 -->
    <div class="top">
      <text class="hd-title" style="color: {{ theme.text }}">倒数日</text>
    </div>

    <!-- 工具行：只有列表非空时出现。改成纯文字链接（原来是两枚 44px 胶囊），
         iOS 风格的列表页不放常驻按钮，操作降为弱提示不抢视线。 -->
    <div class="toolbar" if="{{ countdownList.length > 0 }}">
      <text class="toolbar-link" onclick="toggleSort" style="color: {{ theme.textSecondary }}">{{ sortRecent ? '按时间' : '按名称' }}</text>
      <text class="toolbar-link" onclick="clearAll"
            style="color: {{ clearAllConfirm ? theme.deleteText : theme.textMuted }}">{{ clearAllConfirm ? '确认清空' : '清空' }}</text>
    </div>

    <scroll class="list-scroll" scroll-y="{{true}}">
      <div for="{{ (idx, item) in countdownList }}" class="cd-item">
        <div class="cd-group-divider" if="{{ item.showDivider }}">
          <div class="cd-group-line" style="background-color: {{ theme.border }}"></div>
          <text class="cd-group-label" style="color: {{ theme.textMuted }}">已结束</text>
        </div>

        <!-- 版式 A · 标准卡（layout=card，默认）
             卡片只承载「读」：标题 / 天数 / 进度 / 日期。写操作全在编辑页。 -->
        <div class="countdown-row" if="{{ layout === 'card' }}"
             style="{{ item.cardBg }}; opacity: {{ item.enabled ? 1 : 0.5 }}; {{ item.cardBorder }}"
             onclick="openForm(item.id)">
          <div class="cd-head">
            <text class="cd-title" style="color: {{ theme.text }}">{{ item.title }}</text>
            <text if="{{ !item.enabled }}" class="cd-off-tag" style="color: {{ theme.textMuted }}">已关闭</text>
          </div>

          <!-- 天数行：大数字 + 小单位，基线对齐（unit 用 margin-bottom 微调，
               Vela 的 align-items:flex-end 在不同固件上表现不一致） -->
          <div class="cd-days-row">
            <text class="cd-days" style="color: {{ item.daysColor }}">{{ item.numText }}</text>
            <text class="cd-unit" style="color: {{ item.daysColor }}">{{ item.unitText }}</text>
          </div>

          <text class="cd-date" style="color: {{ theme.textSecondary }}">{{ item.dateLine }}</text>
          <text if="{{ item.lunarLine }}" class="cd-lunar" style="color: {{ item.lunarColor }}">{{ item.lunarLine }}</text>

          <!-- 进度做成卡片底部的细彩条（3px）：iOS 倒数日首页没有进度条，
               但完全去掉就少了一条「时间在走」的视觉暗示，压到 3px 只做质感 -->
          <div class="cd-bar">
            <div class="cd-bar-track" style="background-color: {{ theme.borderLight }}">
              <div class="cd-bar-fill" style="width: {{ item.fillPx }}px; {{ item.barBg }}"></div>
            </div>
          </div>
        </div>

        <!-- 版式 B · 沉浸大数字（layout=hero）
             竖版居中：标题在上、数字占满整卡宽度、单位在数字下、日期收尾。
             代价是一屏只能 1.7 张，收益是「还剩几天」一眼砸进脑子。
             与版式 A 共用同一份 decorate 字段，只是换了排布。 -->
        <div class="hero-card" if="{{ layout === 'hero' }}"
             style="{{ item.cardBg }}; opacity: {{ item.enabled ? 1 : 0.5 }}; {{ item.cardBorder }}"
             onclick="openForm(item.id)">
          <text class="hero-title" style="color: {{ theme.textSecondary }}">{{ item.title }}</text>
          <text class="hero-num" style="color: {{ item.daysColor }}">{{ item.numText }}</text>
          <text class="hero-unit" style="color: {{ item.daysColor }}">{{ item.heroUnit }}</text>
          <text class="hero-date" style="color: {{ theme.textSecondary }}">{{ item.dateLine }}</text>
          <text if="{{ item.lunarLine }}" class="hero-lunar" style="color: {{ item.lunarColor }}">{{ item.lunarLine }}</text>
          <div class="hero-bar">
            <div class="cd-bar-track" style="background-color: {{ theme.borderLight }}">
              <div class="cd-bar-fill" style="width: {{ item.heroFillPx }}px; {{ item.barBg }}"></div>
            </div>
          </div>
        </div>
      </div>

      <text if="{{ countdownList.length === 0 }}" class="empty-text" style="color: {{ theme.textMuted }}">还没有倒数日</text>
      <text if="{{ countdownList.length === 0 }}" class="empty-sub" style="color: {{ theme.textMuted }}">点下方按钮添加一个</text>
      <div class="list-pad" if="{{ countdownList.length > 0 }}"></div>
    </scroll>

    <!-- 底部常驻操作行（v0.3.0 新增）：
         192 屏内容宽 168 = 主按钮 96 + 间隔 8 + 设置 64。
         这一行是所有页面唯一稳定的「低风险热区」——屏幕底部中间，
         圆角裁切不到、也不会和列表滚动抢手势。 -->
    <div class="actions">
      <div class="act-add" onclick="startAdd" style="background-color: {{ theme.accent }}">
        <text class="act-add-t" style="color: {{ theme.bg }}">＋添加</text>
      </div>
      <div class="act-set" onclick="goSettings" style="background-color: {{ theme.cardLight }}">
        <text class="act-set-t" style="color: {{ theme.text }}">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
const countdown = require("../../data/countdown.js")
const theme = require("../../data/theme.js")

export default {
  private: {
    iconTheme: "dark",
    isLight: false,
    theme: {
      bg: "#000000",
      card: "#1c1c1e",
      cardLight: "#2c2c2e",
      accent: "#0a84ff",
      text: "#ffffff",
      textSecondary: "#8e8e93",
      textMuted: "#6e6e73",
      border: "#3a3a3c",
      borderLight: "#2c2c2e",
      btnSecondary: "#3a3a3c",
      btnSecondaryText: "#ffffff",
      deleteBg: "#3a3a3c",
      deleteText: "#ff453a"
    },
    countdownList: [],
    // 列表版式：card = 标准卡（默认） / hero = 沉浸大数字。存 storage key cd_layout
    layout: "card",
    sortRecent: true,
    clearAllConfirm: false,
    clearTimer: null
  },

  onInit() {
    var self = this
    theme.getTheme(function(t, themeName) {
      self.theme = t
      // 浅色主题（晨光白/暖阳米）决定色块是提亮还是压暗
      self.isLight = (themeName === "light" || themeName === "warm")
      self.iconTheme = self.isLight ? 'light' : 'dark'
      self.loadLayout()
      self.loadList()
    })
  },

  onShow() {
    // 从编辑页 / 设置页返回必须重读：否则新增、删除、换主题/换版式都不可见
    this.loadLayout()
    this.loadList()
  },

  // 版式偏好：读不到（首装/脏数据）一律回落 card，不抛错
  loadLayout() {
    var self = this
    storage.get({
      key: "cd_layout",
      success: function (v) {
        self.layout = (v === "hero") ? "hero" : "card"
      },
      fail: function () {
        self.layout = "card"
      }
    })
  },

  openForm(id) {
    var uri = "/pages/cd-edit"
    var go = function() { router.push({ uri: uri }) }
    storage.set({
      key: "cd_edit_id",
      value: id ? String(id) : "",
      success: go,
      fail: go
    })
  },

  startAdd() {
    this.openForm("")
  },

  loadList() {
    var self = this
    // 主题也在这里刷新：设置页换完主题返回，列表页底色必须立刻跟着变
    theme.getTheme(function(t, themeName) {
      self.theme = t
      self.isLight = (themeName === "light" || themeName === "warm")
      countdown.load(function(res) {
        var items = res.items
        countdown.recompute(items)
        countdown.sortForDisplay(items, self.sortRecent ? "recent" : "name")
        self.decorate(items)
        self.countdownList = items
      })
    })
  },

  // 为排序后的列表逐条附展示字段。
  // 卡片内可用宽度：192 - 2*12(页面) - 2*12(卡片内边距) = 144px，
  // 所有定量都按这个常数算（进度条 144、日期行 144）。
  decorate(items) {
    var prevGroup = -1
    var light = this.isLight
    for (var i = 0; i < items.length; i++) {
      var it = items[i]
      it.status = countdown.statusOf(it)
      var d = it.daysLeft
      var hex = countdown.colorOf(it)
      var textColor = countdown.adaptColor(hex, light)
      it.cardBg = "background-color: " + countdown.tintColor(hex, light ? 0.13 : 0.18)
      it.cardBorder = "border: 1px solid " + countdown.tintColor(hex, light ? 0.45 : 0.55)

      if (it.status === "done") {
        it.numText = String(-d)
        it.unitText = "天前"
        it.heroUnit = "天前"
        it.daysColor = this.theme.textMuted
        it.barBg = "background-color: " + this.theme.textMuted
      } else if (it.status === "today") {
        it.numText = "0"
        it.unitText = "今天"
        it.heroUnit = "就是今天"
        it.daysColor = textColor
        it.barBg = "background-color: " + textColor
      } else {
        it.numText = String(d)
        it.unitText = "天"
        it.heroUnit = "天后"
        it.daysColor = textColor
        it.barBg = "background-color: " + textColor
      }

      it.dateLine = this.dateLine(it.date)
      // 只放 lunarText 本体（如「八月初八」），不加「农历」前缀：
      // 24px 下「农历闰四月初十」7 字 = 168px 远超卡内宽 144px 必折行，
      // 而「闰四月初十」6 字 = 144px 正好放下（ev-six 最小 24，不能再缩）。
      it.lunarLine = (it.cal === "lunar" && it.lunarText) ? String(it.lunarText) : ""
      it.lunarColor = it.status === "done" ? this.theme.textMuted : textColor

      var p = countdown.progressOf(it)
      it.fillPx = Math.max(4, Math.round(144 * p))
      // hero 卡内宽 = 192 - 2*12(页面) - 2*10(卡内边距) = 148
      it.heroFillPx = Math.max(4, Math.round(148 * p))
      var g = it.status === "done" ? 1 : 0
      it.showDivider = (i > 0 && g !== prevGroup)
      prevGroup = g
    }
  },

  // 日期行只给 date 本体。曾试过拼「周X」，18px 下 "2027-02-17 周三" 实测
  // 149px > 卡片内宽 144px 直接折行（版面还原图实证），20px 更宽。
  // 星期对「还剩几天」没有决策价值，砍掉换回一行的整齐。
  dateLine(s) {
    return String(s || "")
  },

  persistList(list) {
    var self = this
    countdown.save(list, function() {
      self.loadList()
    })
  },

  toggleSort() {
    this.sortRecent = !this.sortRecent
    var list = this.countdownList.slice()
    countdown.sortForDisplay(list, this.sortRecent ? "recent" : "name")
    this.decorate(list)
    this.countdownList = list
  },

  clearAll() {
    var self = this
    if (this.clearAllConfirm) {
      this.persistList([])
      clearTimeout(this.clearTimer)
      this.clearAllConfirm = false
      return
    }
    this.clearAllConfirm = true
    clearTimeout(this.clearTimer)
    this.clearTimer = setTimeout(function() {
      self.clearAllConfirm = false
    }, 3000)
  },

  // 首页没有上一页，router.back() 无栈可退 —— 直接推设置页
  goSettings() {
    try {
      router.push({ uri: '/pages/settings' })
    } catch (e) {}
  },

  // 兼容旧模板里可能残留的 goMenu 调用
  goMenu() {
    this.goSettings()
  },

  onDestroy() {
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    this.countdownList = null
    this.theme = null
  }
}
</script>

<style>

/* ================================================================
   BASE CSS = 手环 9 基准（192 屏 / 内容区 168px，卡片内宽 144px）
   手环 9 默认命中，不依赖任何 media query。
   大屏（rect）只在文件末尾做增量，不覆盖 base 字号体系。
   布局数字（v0.3.0 实算，192×490 屏幕）：
     顶栏    48 + 上边距 14            = 62
     工具行  26 + 下边距 8             = 34
     底部行  44 + 上下边距 14          = 58
     列表可视 490 - 62 - 34 - 58       = 336  → 一屏 3 张卡（每张约 118 含间距）
   ================================================================ */

.page {
  flex: 1;
  flex-direction: column;
  padding: 0 12px;
}

/* 顶栏：居中纯文字标题，不做胶囊、不可点 */
.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 14px;
  justify-content: center;
  align-items: center;
}

.hd-title {
  font-size: 30px;
  line-height: 40px;
  font-weight: bold;
  lines: 1;
}

/* 工具行：两端小字，弱到不抢卡片视线 */
.toolbar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 26px;
  padding: 0 4px;
  margin-top: 8px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.toolbar-link {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  flex-shrink: 0;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

/* 列表项必须显式撑满：Vela 的 div 宽度默认随内容收缩 */
.cd-item {
  width: 100%;
  flex-direction: column;
}

/* 卡片：圆角 16 + 12px 内边距（144 内宽）。底色与描边由条目色派生（见 decorate） */
.countdown-row {
  flex-direction: column;
  width: 100%;
  flex-shrink: 0;
  border-radius: 16px;
  padding: 10px 12px 12px 12px;
  margin-bottom: 8px;
}

.cd-head {
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
  flex-shrink: 0;
}

/* 标题独占整行，不设 lines —— 长标题自然换行，绝不省略号或被裁切 */
.cd-title {
  font-size: 24px;
  line-height: 30px;
  flex: 1;
  min-width: 0;
}

/* 天数行：卡片的主角。40px 粗体数字 + 20px 单位。
   三位数「365」≈ 72px + 「天」20px = 92px，144 内宽放得下 */
.cd-days-row {
  flex-direction: row;
  align-items: flex-end;
  width: 100%;
  flex-shrink: 0;
  margin-top: 2px;
}

/* ev-six 次大档 44：天数是本页唯一的一级信息 */
.cd-days {
  font-size: 44px;
  line-height: 52px;
  font-weight: bold;
  flex-shrink: 0;
}

.cd-unit {
  font-size: 24px;
  line-height: 30px;
  margin-left: 4px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.cd-bar {
  margin-top: 8px;
  height: 3px;
  justify-content: center;
  width: 100%;
  flex-shrink: 0;
}

.cd-bar-track {
  width: 100%;
  height: 3px;
  border-radius: 2px;
  opacity: 0.5;
}

.cd-bar-fill {
  height: 3px;
  border-radius: 2px;
}

.cd-date {
  font-size: 24px;
  line-height: 30px;
  width: 100%;
  margin-top: 4px;
  lines: 1;
}

/* 农历行：与公历同号同色系，只靠颜色区分主次 */
.cd-lunar {
  font-size: 24px;
  line-height: 30px;
  width: 100%;
  margin-top: 1px;
  lines: 1;
}

.cd-off-tag {
  font-size: 24px;
  line-height: 30px;
  flex-shrink: 0;
  margin-left: 6px;
}

.cd-group-divider {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin: 2px 2px 8px 2px;
}

.cd-group-line {
  flex: 1;
  height: 2px;
  opacity: 0.5;
}

.cd-group-label {
  font-size: 24px;
  line-height: 30px;
  margin-left: 6px;
  flex-shrink: 0;
}

/* 底部常驻行：主按钮 96 + 间隔 8 + 设置 64 = 168 */
.actions {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 6px;
  margin-bottom: 14px;
  flex-shrink: 0;
}

.act-add {
  height: 44px;
  flex: 1;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}

.act-add-t {
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  lines: 1;
}

.act-set {
  width: 60px;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin-left: 8px;
  flex-shrink: 0;
}

.act-set-t {
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  lines: 1;
}

.empty-text {
  font-size: 24px;
  line-height: 32px;
  text-align: center;
  width: 100%;
  margin-top: 56px;
}

.empty-sub {
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  width: 100%;
  margin-top: 2px;
}

/* 列表底部留白：让最后一张卡不贴着常驻按钮行 */
.list-pad {
  width: 100%;
  height: 8px;
  flex-shrink: 0;
}

/* ---- 版式 B · 沉浸大数字：整卡居中，数字 64px ----
   卡高 = 14 + 28(标题) + 72(数字) + 24(单位) + 6 + 26(日期) + 12 = 182，
   一屏 336px 只能放 1.7 张 —— 这是选它的代价，不是缺陷。
   64px 「107」≈ 114px < 卡内宽 148px；四位数 152px 会超，
   但四位数倒数日（>999 天）本来就极少，且会自然收缩不裁切。 */
.hero-card {
  flex-direction: column;
  width: 100%;
  flex-shrink: 0;
  border-radius: 18px;
  padding: 14px 10px 12px 10px;
  margin-bottom: 10px;
  align-items: center;
}

.hero-title {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  text-align: center;
}

/* 64px 超出 ev-six 四档，属「主数字＝图形本体」豁免（同课程表表盘 76/104 的处理），
   理由：这一版式存在的唯一目的就是让天数成为整屏视觉主体，压回 44 就与标准卡无差别 */
.hero-num {
  font-size: 64px;
  line-height: 72px;
  font-weight: bold;
  text-align: center;
}

.hero-unit {
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  margin-top: 2px;
}

.hero-date {
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  margin-top: 8px;
}

.hero-lunar {
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  margin-top: 1px;
}

.hero-bar {
  margin-top: 10px;
  height: 3px;
  justify-content: center;
  width: 100%;
}

/* 大屏（9 Pro / 10 Pro 等 rect 屏）只做增量 */
@media (shape: rect) {
  .page {
    padding: 0 20px;
  }
  .countdown-row {
    padding: 14px;
  }
  .actions {
    margin-bottom: 18px;
  }
}
</style>
