<!-- 首页 = 倒数日列表（manifest router.entry 指向本页）
     2026-11-02 v0.3.0 视觉重做（iOS「倒数日 / Days Matter」风格）：
       1) 顶部不再是可点胶囊 —— 标题只当标题，用户不会再以为「菜单」是返回；
          设置入口改为底部常驻双按钮行（＋ 添加 / 设置），
          彻底避开胶囊屏顶部两个圆角的裁切区（192 屏 y<60 时 x<24 会被圆角吃掉）。
       2) 卡片版式从「标题 → 剩 N 天 → 进度 → 日期」四段压缩为
          「标题 → 大数字 + 单位 → 细进度 → 日期·星期」，
          天数从 26px 提到 40px 成为视觉主角 —— 这是倒数日类应用的核心信息。
       3) 每条仍用自己颜色的淡底 + 淡描边（tint），一屏内多条目可分辨。
-->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 顶栏：居中纯文字标题。故意不可点 —— 首页没有上一页，
         任何「看起来能返回」的元素出现在这里是误导（v0.2.1 之前是「菜单」胶囊）。 -->
    <div class="top">
      <text class="hd-title" style="color: {{ theme.text }}">倒数日</text>
    </div>

    <!-- 工具行：只有列表非空时出现。改成纯文字链接（原来是两枚 44px 胶囊），
         iOS 风格的列表页不放常驻按钮，操作降为弱提示不抢视线。 -->
    <div class="toolbar" if="{{ countdownList.length > 0 }}">
      <text class="toolbar-link" onclick="toggleSort" style="color: {{ theme.textSecondary }}">{{ sortRecent ? '按时间' : '按名称' }}</text>
      <!-- 右侧是「版式」切换而不是「清空」（2026-11-02 用户决定）：
           版式是高频轻操作，清空是低频危险操作，两者的热区权重不该一样。
           清空下沉到设置页（那里才有二次确认的位置）。 -->
      <text class="toolbar-link" onclick="toggleLayout"
            style="color: {{ theme.accent }}">{{ layout === 'hero' ? '大字' : '列表' }}</text>
    </div>

    <scroll class="list-scroll" scroll-y="{{true}}">
      <div for="{{ (idx, item) in countdownList }}" class="cd-item">
        <div class="cd-group-divider" if="{{ item.showDivider }}">
          <div class="cd-group-line" style="background-color: {{ theme.border }}"></div>
          <text class="cd-group-label" style="color: {{ theme.textMuted }}">已结束</text>
        </div>

        <!-- 版式 A · 简单列表（layout=list，默认）：**两列**
             左列 = 标题，允许折两行（lines:2，超出省略）；右列 = 大数字 + 小单位。
             为什么改成两列（2026-11-02 用户提议，实测成立）：
               竖向两行的写法里「还有 126 天」要跟标题抢同一行宽度，24px 下
               标题只能分到 3 个字；拆成左右两列后，标题独占左列整块的 2 行 ×
               74px（约 6 字），数字独占右列 74px，两边互不挤压。
             语义不再用「还有/已经」两个词（那要多占一行），改成单位后缀：
               「天后」= 目标在未来（倒数）、「天前」= 起点在过去（正计时 / 已过期）。
               一个词就带了方向，比两个词省一整行。 -->
        <div class="ls-row" if="{{ layout !== 'hero' }}"
             style="background-color: {{ item.lsBg }}; opacity: {{ item.enabled ? 1 : 0.5 }}"
             onclick="openForm(item.id)">
          <!-- 两列（2026-11-02 方案 B）：①标题独占 → 4 字/行 ②数字+「天」竖叠
               去掉「还有/已经」后标题拿满 96px，8 字长名（数学期末考试）能整条显示。
               方向语义改由数字前缀承担：正计时「+306」、已过「-5」（并压灰），
               倒计时不加前缀。为什么不纯用颜色：每条记录的颜色是用户自选的，
               强行改色会覆盖它，底色 tint 也会跟着打架，所以颜色仍归用户，符号管方向。 -->
          <text class="ls-title" style="color: {{ theme.text }}">{{ item.title }}</text>
          <div class="num-box">
            <text if="{{ item.isToday }}" class="ls-today" style="color: {{ item.daysColor }}">今天</text>
            <text if="{{ !item.isToday }}" class="ls-num"
                  style="color: {{ item.daysColor }}; font-size: {{ item.numSize }}px">{{ item.numText }}</text>
            <text if="{{ !item.isToday }}" class="ls-unit" style="color: {{ item.daysColor }}">天</text>
          </div>
        </div>

        <!-- 版式 B · 沉浸大数字（layout=hero）
             竖版居中：标题在上、数字占满整卡宽度、单位在数字下、日期收尾。
             代价是一屏只能 1.7 张，收益是「还剩几天」一眼砸进脑子。
             与版式 A 共用同一份 decorate 字段，只是换了排布。 -->
        <div class="hero-card" if="{{ layout === 'hero' }}"
             style="{{ item.cardBg }}; opacity: {{ item.enabled ? 1 : 0.5 }}; {{ item.cardBorder }}"
             onclick="openForm(item.id)">
          <text class="hero-title" style="color: {{ theme.text }}">{{ item.title }}</text>
          <text if="{{ item.isToday }}" class="hero-today" style="color: {{ item.daysColor }}">就是今天</text>
          <text if="{{ !item.isToday }}" class="hero-num" style="color: {{ item.daysColor }}">{{ item.numText }}</text>
          <text if="{{ !item.isToday }}" class="hero-unit" style="color: {{ item.daysColor }}">{{ item.heroUnit }}</text>
          <text class="hero-date" style="color: {{ theme.textSecondary }}">{{ item.dateLine }}</text>
          <text if="{{ item.lunarLine }}" class="hero-lunar" style="color: {{ item.lunarColor }}">{{ item.lunarLine }}</text>
          <div class="hero-bar">
            <div class="cd-bar-track" style="background-color: {{ theme.borderLight }}">
              <div class="cd-bar-fill" style="width: {{ item.heroFillPx }}px; {{ item.barBg }}"></div>
            </div>
          </div>
        </div>
      </div>

      <text if="{{ countdownList.length === 0 }}" class="empty-text" style="color: {{ theme.textMuted }}">还没有倒数日</text>
      <text if="{{ countdownList.length === 0 }}" class="empty-sub" style="color: {{ theme.textMuted }}">点下方按钮添加一个</text>
      <div class="list-pad" if="{{ countdownList.length > 0 }}"></div>
    </scroll>

    <!-- 底部常驻操作行（v0.3.0 新增）：
         192 屏内容宽 168 = 主按钮 96 + 间隔 8 + 设置 64。
         这一行是所有页面唯一稳定的「低风险热区」——屏幕底部中间，
         圆角裁切不到、也不会和列表滚动抢手势。 -->
    <div class="actions">
      <div class="act-add" onclick="startAdd" style="background-color: {{ theme.accent }}">
        <text class="act-add-t" style="color: {{ theme.bg }}">＋添加</text>
      </div>
      <div class="act-set" onclick="goSettings" style="background-color: {{ theme.cardLight }}">
        <text class="act-set-t" style="color: {{ theme.text }}">设置</text>
      </div>
    </div>

    <!-- 版本号：居中独立一行（v0.5.4 用户要求）。
         放按钮下方而不是列表下方：列表是滚动区，版本号跟滚动会忽上忽下；
         钉在屏幕最底部才叫「页脚」。 -->
    <div class="ver-line">
      <text class="ver-t" style="color: {{ theme.textMuted }}">{{ verText }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import app from "@system.app"
import storage from "@system.storage"
const countdown = require("../../data/countdown.js")
const theme = require("../../data/theme.js")

export default {
  private: {
    iconTheme: "dark",
    isLight: false,
    // 页脚版本号：读不到就空着，不写死字符串（写死会与 manifest 脱节）
    verText: "",
    theme: {
      bg: "#000000",
      card: "#1c1c1e",
      cardLight: "#2c2c2e",
      accent: "#0a84ff",
      text: "#ffffff",
      textSecondary: "#8e8e93",
      textMuted: "#6e6e73",
      border: "#3a3a3c",
      borderLight: "#2c2c2e",
      btnSecondary: "#3a3a3c",
      btnSecondaryText: "#ffffff",
      deleteBg: "#3a3a3c",
      deleteText: "#ff453a"
    },
    countdownList: [],
    // 列表版式：list = 简单列表（默认，两行一条） / hero = 大字（竖版居中）。key cd_layout
    layout: "list",
    sortRecent: true,
    clearAllConfirm: false,
    clearTimer: null
  },

  onInit() {
    var self = this
    // 版本号：从 manifest 读，不在代码里写死
    app.getInfo({
      success: function (d) {
        if (d && d.versionName) self.verText = "v" + d.versionName
      },
      fail: function () {}
    })
    theme.getTheme(function(t, themeName) {
      self.theme = t
      // 浅色主题（晨光白/暖阳米）决定色块是提亮还是压暗
      self.isLight = (themeName === "light" || themeName === "warm")
      self.iconTheme = self.isLight ? 'light' : 'dark'
      self.loadLayout()
      self.loadList()
    })
  },

  onShow() {
    // 从编辑页 / 设置页返回必须重读：否则新增、删除、换主题/换版式都不可见
    this.loadLayout()
    this.loadList()
  },

  // 版式偏好：读不到（首装/脏数据）一律回落 card，不抛错
  loadLayout() {
    var self = this
    storage.get({
      key: "cd_layout",
      success: function (v) {
        // 老版本存的是 "card"（标准卡），现在这个值对应「简单列表」版式，
        // 一律归一到 list，不做数据迁移
        self.layout = (v === "hero") ? "hero" : "list"
      },
      fail: function () {
        self.layout = "list"
      }
    })
  },

  openForm(id) {
    var uri = "/pages/cd-edit"
    var go = function() { router.push({ uri: uri }) }
    storage.set({
      key: "cd_edit_id",
      value: id ? String(id) : "",
      success: go,
      fail: go
    })
  },

  startAdd() {
    this.openForm("")
  },

  loadList() {
    var self = this
    // 主题也在这里刷新：设置页换完主题返回，列表页底色必须立刻跟着变
    theme.getTheme(function(t, themeName) {
      self.theme = t
      self.isLight = (themeName === "light" || themeName === "warm")
      countdown.load(function(res) {
        var items = res.items
        countdown.recompute(items)
        countdown.sortForDisplay(items, self.sortRecent ? "recent" : "name")
        self.decorate(items)
        self.countdownList = items
      })
    })
  },

  // 为排序后的列表逐条附展示字段。
  // 卡片内可用宽度：192 - 2*12(页面) - 2*12(卡片内边距) = 144px，
  // 所有定量都按这个常数算（进度条 144、日期行 144）。
  decorate(items) {
    var prevGroup = -1
    var light = this.isLight
    for (var i = 0; i < items.length; i++) {
      var it = items[i]
      var d = it.daysLeft
      var isUp = (it.mode === "up")
      var hex = countdown.colorOf(it)
      var textColor = countdown.adaptColor(hex, light)
      // 简单列表：只要一层很淡的色底（不描边），让彩色数字有归属感，又不至于变成 6 块色板
      it.lsBg = countdown.tintColor(hex, light ? 0.10 : 0.13)
      it.cardBg = "background-color: " + countdown.tintColor(hex, light ? 0.13 : 0.18)
      it.cardBorder = "border: 1px solid " + countdown.tintColor(hex, light ? 0.45 : 0.55)

      // 正计时（mode=up）：起点在过去，天数 = |daysLeft|
      // 倒数（mode=down）：目标在未来，天数 = daysLeft
      // 两者共用同一套展示字段，只有 phrase（还有/已经）与是否置灰不同。
      var n = isUp ? Math.abs(d) : d
      var done = (!isUp && d < 0)
      it.isToday = (n === 0)
      it.status = isUp ? "active" : (done ? "done" : (n === 0 ? "today" : "active"))

      if (it.isToday) {
        it.phrase = ""
        it.numText = "0"
        it.unitText = "天"
        it.heroUnit = "天"
      } else if (isUp) {
        it.phrase = "已经"
        // 方案 B：方向不再写「已经」二字，改用前缀符号 + 已过压灰来表达。
        it.numText = "+" + n
        it.unitText = "天"
        it.heroUnit = "天"
      } else if (done) {
        it.phrase = "已过"
        it.numText = "-" + Math.abs(d)
        it.unitText = "天"
        it.heroUnit = "天"
      } else {
        it.phrase = "还有"
        it.numText = String(n)
        it.unitText = "天"
        it.heroUnit = "天后"
      }

      // 字号随位数收敛：2 字符以内 44px（ev-six 次大档），4 字符起降到 30px。
      // 符号也算字符：「+306」「1234」都是 4 字符 → 30px，60px 宽稳稳装进 68px 数字列。
      it.numSize = (it.numText.length >= 4) ? 30 : 44
      // dirWord 保留计算（hero 版式/调试仍可能读），但列表版式已不再渲染它。
      it.dirWord = isUp ? "已经" : (done ? "已过" : "还有")
      it.daysColor = (done ? this.theme.textMuted : textColor)
      it.barBg = "background-color: " + it.daysColor

      var pr = countdown.progressOf(it)
      it.fillPx = Math.max(4, Math.round(144 * pr))
      it.heroFillPx = Math.max(4, Math.round(148 * pr))
      var g = done ? 1 : 0
      it.showDivider = (i > 0 && g !== prevGroup)
      prevGroup = g
    }
  },

  // 日期行只给 date 本体。曾试过拼「周X」，18px 下 "2027-02-17 周三" 实测
  // 149px > 卡片内宽 144px 直接折行（版面还原图实证），20px 更宽。
  // 星期对「还剩几天」没有决策价值，砍掉换回一行的整齐。
  dateLine(s) {
    return String(s || "")
  },

  persistList(list) {
    var self = this
    countdown.save(list, function() {
      self.loadList()
    })
  },

  // 版式一键切换：只写 storage + 改 layout，两套 DOM 共用同一份 decorate 字段，
  // 不需要重新加载数据（hero 用的 numText/heroUnit 在 decorate 里已经算好）
  toggleLayout() {
    const self = this
    const next = (this.layout === 'hero') ? 'list' : 'hero'
    storage.set({
      key: 'cd_layout',
      value: next,
      success: function () { self.layout = next },
      fail: function () { self.layout = next }
    })
  },

  toggleSort() {
    this.sortRecent = !this.sortRecent
    var list = this.countdownList.slice()
    countdown.sortForDisplay(list, this.sortRecent ? "recent" : "name")
    this.decorate(list)
    this.countdownList = list
  },

  clearAll() {
    var self = this
    if (this.clearAllConfirm) {
      this.persistList([])
      clearTimeout(this.clearTimer)
      this.clearAllConfirm = false
      return
    }
    this.clearAllConfirm = true
    clearTimeout(this.clearTimer)
    this.clearTimer = setTimeout(function() {
      self.clearAllConfirm = false
    }, 3000)
  },

  // 首页没有上一页，router.back() 无栈可退 —— 直接推设置页
  goSettings() {
    try {
      router.push({ uri: '/pages/settings' })
    } catch (e) {}
  },

  // 兼容旧模板里可能残留的 goMenu 调用
  goMenu() {
    this.goSettings()
  },

  onDestroy() {
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    this.countdownList = null
    this.theme = null
  }
}
</script>

<style>

/* ================================================================
   BASE CSS = 手环 9 基准（192 屏 / 内容区 168px，卡片内宽 144px）
   手环 9 默认命中，不依赖任何 media query。
   大屏（rect）只在文件末尾做增量，不覆盖 base 字号体系。
   布局数字（v0.3.0 实算，192×490 屏幕）：
     顶栏    48 + 上边距 14            = 62
     工具行  26 + 下边距 8             = 34
     底部行  44 + 上下边距 14          = 58
     列表可视 490 - 62 - 34 - 58       = 336  → 一屏 3 张卡（每张约 118 含间距）
   ================================================================ */

.page {
  flex: 1;
  flex-direction: column;
  padding: 0 6px;
}

/* 顶栏：居中纯文字标题，不做胶囊、不可点 */
.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 14px;
  justify-content: center;
  align-items: center;
}

.hd-title {
  font-size: 30px;
  line-height: 40px;
  font-weight: bold;
  lines: 1;
}

/* 工具行：两端小字，弱到不抢卡片视线 */
.toolbar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 26px;
  padding: 0 4px;
  margin-top: 8px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.toolbar-link {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  flex-shrink: 0;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

/* 列表项必须显式撑满：Vela 的 div 宽度默认随内容收缩 */
.cd-item {
  width: 100%;
  flex-direction: column;
}

/* ---- 版式 A · 简单列表：三列 · 卡高 88（一屏 4 条）----
   内宽 = 192 - 2×6(页面) - 2×8(卡内) = 164，切成：
     左列 flex:1 → 62px（24px 下每行 2 字，「2026」这类 4 字符标题约 58px 刚好）
     天数列 78px（44px 三位「126」实测约 80px，78 会溢出 2px，属可接受：
        text-align:right 只向左吐 2px，落在左列右侧留白里，不会压到字）
     「天」列 24px（24px 字，独占一列、line-height 与数字同高 46 → 真上下居中）
   为什么要三列而不是两列（2026-11-02 用户要求）：两列时「天」和数字挤在一列，
   三位数会被截断；拆开后数字拿满 76px，三位数不再变形。 */
.ls-row {
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 88px;
  flex-shrink: 0;
  border-radius: 14px;
  padding: 0 8px 0 8px;
  margin-bottom: 8px;
}

/* 左列：标题 + 方向词（span 同段）。lines:2 → 最多两行，超出省略。
   严格两行的理由：列表整齐感来自「每条等高」，允许三行会让一屏条数浮动、
   滚动位置跳动；看全文点卡片进编辑页。 */
.ls-title {
  flex: 1;
  min-width: 0;
  font-size: 24px;
  line-height: 30px;
  lines: 2;
}

/* 天数：不再是独立列，宽度由父级 .num-box 的 68px 给。
   44px 粗体（ev-six 次大档）；4 字符（+306 / 1234）由 decorate 降到 30px。 */
.ls-num {
  line-height: 42px;
  font-weight: bold;
  text-align: right;
}

/* 数字列：「天」从独立列改到数字正下方（右对齐），省下的 24px 全给标题。
   68px 是算出来的：44px 两位数 ≈ 58px、30px 的「+306」/「1234」≈ 60px，
   两种都装得下；line-height 42+24=66 < 88 卡高，垂直居中后上下各留 11px。 */
.num-box {
  width: 68px;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
}

/* 「天」：数字下方，24px，右对齐与数字右缘齐平 */
.ls-unit {
  font-size: 24px;
  line-height: 24px;
  font-weight: bold;
  text-align: right;
}

.ls-today {
  font-size: 30px;
  line-height: 42px;
  font-weight: bold;
  text-align: right;
}

/* 进度条只剩「大字」版式在用（简单列表刻意不给进度，见模板注释） */
.cd-bar-track {
  width: 100%;
  height: 3px;
  border-radius: 2px;
  opacity: 0.5;
}

.cd-bar-fill {
  height: 3px;
  border-radius: 2px;
}

.cd-group-divider {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin: 2px 2px 8px 2px;
}

.cd-group-line {
  flex: 1;
  height: 2px;
  opacity: 0.5;
}

.cd-group-label {
  font-size: 24px;
  line-height: 30px;
  margin-left: 6px;
  flex-shrink: 0;
}

/* 底部常驻行：主按钮 96 + 间隔 8 + 设置 64 = 168 */
.actions {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 6px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.act-add {
