<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<!-- 通用文字输入页（从 class-schedule 的 pages/chinese-input 改写）
     为什么要单独一页、而不是在 cd-edit 里内嵌键盘：
     cd-edit 的根节点是 <scroll>（表单比一屏高），键盘组件内部是 position:absolute 贴底，
     塞进滚动容器会同时出现「键盘跟着滚走」和「flex 高度塌陷」两个问题。
     独立页 + storage 回传是课程表验证过的路径，这里沿用同一套 storage 契约，
     使 cd-edit 的 openInputPage 只需改一个 URI。

     storage 契约（键名沿用 chinese_input_*，与课程表保持一致）：
       读 chinese_input_title / placeholder / value / maxlen / return_key
       写 return_key

     三条真机硬约束（照抄 pages/nickname/nickname.ux，都是实测结论）：
     - screentype 必须写死 "rect"，pill-shaped 在 212×520 白屏
     - input-method 必须 onReady 后延迟 300ms 挂载，首帧挂载会被静默丢弃
     - .ime-host 必须 flex:1 且有 min-height，.top 必须 flex-shrink:0
     字号只用 ev-six 四档：44 / 30 / 28 / 24 -->

<template>
  <div class="page">
    <div class="top">
      <div class="hd" onclick="goBack">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t">{{ pageTitle }}</text>
      </div>
    </div>

    <div class="disp">
      <text class="txt" if="{{ text.length }}">{{ text }}</text>
      <text class="ph" if="{{ !text.length }}">{{ placeholder }}</text>
    </div>

    <div class="ok" onclick="save">
      <text class="ok-t">保存</text>
    </div>

    <!-- 键盘区：与 class-schedule/pages/chinese-input 完全同构 ——
         ① 无条件挂载：不加 if、不延迟 setTimeout、不做机型分支。
            chinese-input 的注释写明：曾用 hide=true 延迟一帧展开，会让组件 onInit
            时跳过词典初始化，表现为「英文能打、中文无候选」；而且延迟期间一旦
            有任何异步分支把 imeOn 留在 false，用户看到的就是「一个键盘都没有」。
            本应用 0.1.1/0.2.0 两次「输入法没加载」都出在这个延迟上。
         ② screentype 取 device.getInfo().screenShape，capsule 映射成 rect
            （212×520 上 pill-shaped 打不开，手环 11 真机七形态对照实测）。
         ③ 宿主必须是普通 div，不能是 scroll：scroll 不拉伸子元素，
            组件内部 position:absolute;bottom:0;width:100% 会退化到内容宽，
            键盘塌缩到左下角。 -->
    <div class="ime-host">
      <input-method
        hide="{{ false }}"
        keyboardtype="QWERTY"
        maxlength="{{ maxLen }}"
        vibratemode="short"
        screentype="{{ screenType }}"
        oncomplete="onChar"
        ondelete="onDel"
      ></input-method>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import device from '@system.device'

var DEFAULT_RETURN_KEY = 'cd_edit_name'

export default {
  data: {
    pageTitle: '输入名称',
    placeholder: '输入名称',
    text: '',
    maxLen: 6,
    screenType: 'rect',   // 默认 rect：getInfo 是异步的，回调前会先渲染一帧
    returnKey: DEFAULT_RETURN_KEY
  },

  onInit() {
    const self = this
    // 键盘形态只跟屏幕形状走，不跟 deviceType 走（deviceType 各家固件回的值不统一，
    // 0.1.1 就是靠它分支把自己坑成「没有键盘」的）。
    // capsule 必须映射成 rect：手环 11 真机七形态对照，pill-shaped / circle 全部打不开。
    device.getInfo({
      success: function (data) {
        var shape = (data && data.screenShape) || 'rect'
        if (shape === 'capsule' || shape === 'circle') shape = 'rect'
        self.screenType = shape
      },
      fail: function () {}
    })
    // 五个参数并行读，互不依赖；读不到就保持默认值，不阻塞页面渲染
    storage.get({
      key: 'chinese_input_title',
      success: function (d) { if (d) self.pageTitle = d },
      fail: function () {}
    })
    storage.get({
      key: 'chinese_input_placeholder',
      success: function (d) { if (d) self.placeholder = d },
      fail: function () {}
    })
    storage.get({
      key: 'chinese_input_value',
      success: function (d) { if (d) self.text = String(d) },
      fail: function () {}
    })
    storage.get({
      key: 'chinese_input_maxlen',
      success: function (d) {
        var n = parseInt(d, 10)
        if (n > 0) self.maxLen = n
      },
      fail: function () {}
    })
    storage.get({
      key: 'chinese_input_return_key',
      success: function (d) { if (d) self.returnKey = String(d) },
      fail: function () {}
    })
  },

  onChar(evt) {
    const c = (evt && evt.detail && evt.detail.content) || ''
    if (!c) return
    const max = this.maxLen
    const next = this.text + c
    this.text = next.length > max ? next.slice(0, max) : next
  },

  onDel() {
    this.text = this.text.length ? this.text.slice(0, this.text.length - 1) : ''
  },

  save() {
    storage.set({
      key: this.returnKey,
      value: this.text || '',
      success: function () { router.back() },
      fail: function () { router.back() }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}

.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  background-color: #3a3a3c;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 28px;
  color: #ffffff;
  lines: 1;
}

.disp {
  width: 176px;
  height: 52px;
  margin-top: 10px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  background-color: #1c1c1e;
  border-radius: 12px;
}

.txt {
  font-size: 30px;
  color: #ffffff;
  lines: 1;
}

.ph {
  font-size: 24px;
  color: #8e8e93;
}

.ok {
  width: 176px;
  height: 44px;
  margin-top: 8px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  background-color: #0a84ff;
  border-radius: 22px;
}

.ok-t {
  font-size: 28px;
  color: #ffffff;
}

.ime-host {
  flex: 1;
  flex-shrink: 0;
  min-height: 250px;
  width: 100%;
  flex-direction: column;
}


</style>
