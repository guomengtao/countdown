<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page">
    <!-- 返回键（2026-11-01 修）：
         1. 原来是 19px 纯文字，热区只有 38×19，手指根本点不中
         2. 更致命的是 .hd 没写 flex-shrink:0 —— 键盘加载后子元素总高超过屏高，
            flex 把页头压缩到近 0 高度，返回直接"消失"，这就是"输入一半返回失效"
         现在：页头 48 固定高 + 48×48 热区 + ev-six 允许的 ‹ 字形 -->
    <div class="hd">
      <div class="back" onclick="goBack">
        <text class="back-t">‹</text>
      </div>
      <text class="title" if="{{ !imeOn }}">{{ name }}</text>
      <div class="hd-pad"></div>
    </div>

    <div class="disp">
      <text class="txt" if="{{ text.length }}">{{ text }}</text>
      <text class="ph" if="{{ !text.length }}">先点下面按钮</text>
    </div>

    <!-- 键盘默认不加载，由用户点一下才插入。
         组件初始化一旦异常会带崩整棵页面树（上一版整页白屏就是这么来的），
         手动加载后：外壳先渲染、崩了也留脚印、不影响继续测下一形态。 -->
    <div class="load" if="{{ !imeOn }}" onclick="arm">
      <text class="load-t">加载键盘</text>
    </div>

    <text class="hint" if="{{ !imeOn }}">不出来就返回</text>

    <div class="ime-host" if="{{ imeOn }}">
      <input-method
        hide="{{ false }}"
        keyboardtype="{{ kbd }}"
        maxlength="{{ maxc }}"
        vibratemode="short"
        screentype="{{ st }}"
        dictionarypath="{{ dp }}"
        oncomplete="onChar"
        ondelete="onDel"
      ></input-method>
    </div>
  </div>
</template>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24，行高比 1.36~1.42
   （44→60、30→40、28→38、24→34） */
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  height: 48px;
  margin-top: 28px;
  margin-top: 28px;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 30px;
  padding-right: 30px;
}

/* 48×48 是整个热区，不只是字形大小 */
.back {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  border-radius: 12px;
  background-color: #3a3a3c;
}

.back-t {
  font-size: 34px;
  color: #ffffff;
  line-height: 40px;
}

.title {
  flex: 1;
  font-size: 28px;
  line-height: 38px;
  color: #ffffff;
  text-align: center;
  lines: 1;
}

/* 与左侧返回等宽，否则标题会偏右 */
.hd-pad {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.disp {
  height: 48px;
  flex-shrink: 0;
  margin-top: 4px;
  margin-left: 12px;
  margin-right: 12px;
  border-radius: 12px;
  background-color: #1c1c1e;
  justify-content: center;
  padding-left: 12px;
}

.txt {
  font-size: 28px;
  line-height: 38px;
  color: #ffffff;
  lines: 1;
}

.ph {
  font-size: 24px;
  line-height: 34px;
  color: #6e6e73;
}

/* 键盘宿主：普通 div + flex:1 + 满宽。
   不能用 scroll（宽度会退化），也不能省 flex:1（组件靠
   position:absolute;bottom:0 定位键盘，父级没高度就塌到左上角）。 */
.ime-host {
  flex: 1;
  flex-shrink: 0;
  flex-direction: column;
  width: 100%;
}

.load {
  flex-shrink: 0;
  margin-top: 8px;
  margin-left: 12px;
  margin-right: 12px;
  height: 48px;
  border-radius: 12px;
  background-color: #0a84ff;
  justify-content: center;
  align-items: center;
}

.load-t {
  font-size: 28px;
  line-height: 38px;
  color: #ffffff;
}

.hint {
  flex-shrink: 0;
  font-size: 24px;
  line-height: 34px;
  color: #6e6e73;
  text-align: center;
  margin-top: 8px;
}
</style>

<script>
import router from '@system.router'
import storage from '@system.storage'
const probe = require('../../common/probe.js')

const FULL = '/components/InputMethod/assets/dictionary/'
const LITE = '/assets/dict-lite/'

// 无头调试开关：>0 时页面渲染后等这么多毫秒自动加载键盘。
// 正式包必须是 0（用户手动点）。模拟器点击注入无效，靠它才能截到键盘态。
const AUTO_ARM_MS = 0

// 7 种形态，每次只变一个变量 —— 避免"改了三处，不知道是谁的锅"。
// name 是给用户看的（ev-six：一行 ≤6P），tech 是给开发者看的。
const MODES = {
  A: { name: '胶囊全键盘', st: 'pill-shaped', kbd: 'QWERTY', dp: FULL, maxc: 5 },
  B: { name: '矩形全键盘', st: 'rect', kbd: 'QWERTY', dp: FULL, maxc: 5 },
  C: { name: '圆形全键盘', st: 'circle', kbd: 'QWERTY', dp: FULL, maxc: 5 },
  D: { name: '胶囊九键', st: 'pill-shaped', kbd: 'T9', dp: FULL, maxc: 5 },
  E: { name: '精简词库', st: 'pill-shaped', kbd: 'QWERTY', dp: LITE, maxc: 5 },
  F: { name: '矩形九键', st: 'rect', kbd: 'T9', dp: LITE, maxc: 5 },
  G: { name: '三候选', st: 'pill-shaped', kbd: 'QWERTY', dp: FULL, maxc: 3 }
}

export default {
  private: {
    mode: 'A',
    name: '',
    st: 'pill-shaped',
    kbd: 'QWERTY',
    dp: FULL,
    maxc: 5,
    text: '',
    chars: 0,
    dels: 0,
    imeOn: false,
    firstHit: false
  },

  onInit() {
    // getParams 在"entry 直指本页"时会抛异常，抛出后面几行全不执行，
    // 表现为 screentype 停在默认值 —— 必须单独兜住
    let p = {}
    try {
      p = router.getParams() || {}
    } catch (e) {
      p = {}
    }
    const fromParams = MODES[p.mode] ? p.mode : ''
    this.applyMode(fromParams || this.mode)

    // params 拿不到时退回 storage。不兜这一手，用户点 B 进来会看到 A，
    // 7 个形态全测成同一个，整趟测试白费。
    if (!fromParams) {
      const self = this
      storage.get({
        key: 'cd_exp_mode',
        success: function (v) {
          if (MODES[v] && v !== self.mode) self.applyMode(v)
        },
        fail: function () {}
      })
    }
  },

  // 切形态的唯一入口，保证 6 个字段一起变、不会半新半旧
  applyMode(k) {
    const m = MODES[k]
    this.mode = k
    this.name = m.name
    this.st = m.st
    this.kbd = m.kbd
    this.dp = m.dp
    this.maxc = m.maxc
    // 进页先落脚印：有 enter 无 shown = 这页连外壳都没渲染出来
    probe.mark('exp-' + k, 'enter')
  },

  onReady() {
    // 能执行到这里 = 外壳渲染成功，组件还没加载
    probe.mark('exp-' + this.mode, 'shown')
    if (AUTO_ARM_MS > 0) {
      const self = this
      setTimeout(function () { self.arm() }, AUTO_ARM_MS)
    }
  },

  arm() {
    // 点下去立刻落脚印再实例化组件：
    // 这一下之后若重启/白屏，诊断页会显示"加载后崩"
    probe.mark('exp-' + this.mode, 'armed')
    this.imeOn = true
  },

  onChar(evt) {
    const c = (evt && evt.detail && evt.detail.content) || ''
    if (!c) return
    if (!this.firstHit) {
      this.firstHit = true
      // 键盘活着、能收按键 —— 最关键的一级脚印
      probe.mark('exp-' + this.mode, 'acted')
    }
    this.text = (this.text + c).slice(-8)
    this.chars = this.chars + c.length
  },

  onDel() {
    this.dels = this.dels + 1
    this.text = this.text.length ? this.text.slice(0, this.text.length - 1) : ''
  },

  goBack() {
    probe.mark('exp-' + this.mode, this.firstHit ? 'done' : 'shown', 'chars=' + this.chars)
    router.back()
  }
}
</script>
