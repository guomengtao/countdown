<!-- 首页
     真机 11：设置科目走 pill-shaped 胶囊键盘（待验证），设置昵称走 rect 方键（已验证可用）
     两个输入页布局策略相反，不要「统一」掉：
       - pages/pill     screentype=pill-shaped，键盘立即挂载
       - pages/nickname screentype=rect，延迟 300ms 挂载
     字号只走 ev-six 四档：44/30/28/24 -->
<template>
  <div class="page">
    <!-- 手势只挂在这个信息块上，不挂页面根节点：
         根节点挂 onswipe 会把系统的「右划退出」吃掉（2026-11-02 实机两次复现） -->
    <div class="mid" onswipe="onSwipe">
      <text class="title">倒数日</text>
      <text class="sub">v{{ ver }}</text>

      <div class="nick-box">
        <text class="nick" if="{{ nick }}">{{ nick }}</text>
        <text class="nick-ph" if="{{ !nick }}">还没设置昵称</text>
      </div>

      <text class="subj" if="{{ subj }}">科目 {{ subj }}</text>
      <text class="subj off" if="{{ !subj }}">科目未设置</text>

      <text class="hint">左滑进入科目</text>
    </div>

    <!-- 主按钮给「设置科目」：当前真机测试主线 -->
    <div class="btn primary" onclick="goPill">
      <text class="btn-t">设置科目</text>
    </div>

    <div class="btn" onclick="goNick">
      <text class="btn-t">设置昵称</text>
    </div>

    <!-- 底部并排：诊断 + 退出。退出是兜底动作 —— 只要本应用在手势上占过位，
         系统的右划退出就可能失效，必须给用户一个明确的出口 -->
    <div class="brow">
      <div class="btn half" onclick="goDiag">
        <text class="btn-t">诊断</text>
      </div>
      <div class="btn half quit" onclick="quitApp">
        <text class="btn-t">退出</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    subj: '',
    tx: 0,
    ty: 0,
    tt: 0,
    navAt: 0
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadAll()
  },

  // 从设置页返回时要重新读一次，否则显示的永远是旧值
  onShow() {
    this.loadAll()
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
    storage.get({
      key: 'cd_subject',
      success: function (d) {
        self.subj = d || ''
      },
      fail: function () {
        self.subj = ''
      }
    })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },

  // 首页左滑 = 进入「设置科目」。
  // 注意：「右划」是系统官方的退出/返回手势，绝不能占用（占了会导致退出失败）；
  // 所以进入设置科目只用「左滑」，并且右划必须原样留给系统，本页不拦。
  // 双通道：优先用 Vela 的 onswipe（部分平台/版本不派发），
  // 再兜一层 touch 起止坐标判定，两个通道都命中时用 navAt 去重，避免连开两页。
  // 首页左滑 = 进入「设置科目」。
  // ⚠️ 只用 Vela 原生 onswipe，绝对不要在页面根节点挂 touchstart/touchend：
  // 2026-11-02 实测，根节点一挂 touch 监听，系统默认的「右划退出」就被吃掉，
  // 手环上右滑退不出去（用户实机复现）。原生 onswipe 只读方向，不抢触摸流，
  // 系统手势照常工作。
  // 方向约定：「右划」= 系统退出，不能占用；进入设置科目只用「左滑」。
  onSwipe(evt) {
    const dir = (evt && evt.direction) || ''
    if (dir === 'left') this.goPillOnce()
  },

  goPillOnce() {
    const now = Date.now()
    if (this.navAt && now - this.navAt < 800) return
    this.navAt = now
    router.push({ uri: '/pages/pill' })
  },

  goPill() {
    router.push({ uri: '/pages/pill' })
  },

  goDiag() {
    router.push({ uri: '/pages/diag' })
  },

  // 退出兜底：优先 app.terminate()（手环上等于退出应用），
  // 万一该 API 在当前镜像不可用，退回 router.back()，两种都试一遍不阻塞 UI
  quitApp() {
    try {
      app.terminate()
    } catch (e) {}
    setTimeout(function () {
      try {
        router.back()
      } catch (e) {}
    }, 80)
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding-top: 10px;
}

.title {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  color: #ffffff;
}

.sub {
  font-size: 24px;
  line-height: 34px;
  color: #6e6e73;
}

.nick-box {
  width: 176px;
  height: 56px;
  margin-top: 16px;
  justify-content: center;
  align-items: center;
  border-radius: 12px;
  background-color: #1c1c1e;
}

.nick {
  font-size: 30px;
  line-height: 40px;
  color: #ffffff;
  lines: 1;
}

.nick-ph {
  font-size: 24px;
  line-height: 34px;
  color: #8e8e93;
}

.subj {
  margin-top: 8px;
  font-size: 24px;
  line-height: 30px;
  color: #ffffff;
  flex-shrink: 0;
}
.subj.off {
  color: #8e8e93;
}

/* 手势提示：只是一句小字，不占点击热区 */
.hint {
  margin-top: 2px;
  font-size: 24px;
  line-height: 30px;
  color: #6e6e73;
  flex-shrink: 0;
}

.btn {
  width: 176px;
  height: 48px;
  margin-top: 10px;
  border-radius: 24px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}

.primary {
  background-color: #0a84ff;
  margin-top: 18px;
}

.btn-t {
  font-size: 28px;
  line-height: 38px;
  color: #ffffff;
}
/* 手势区：只包住标题/版本/昵称/科目/提示这块，不铺满整屏 */
.mid {
  width: 100%;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
}

/* 底部并排两个小按钮：诊断 + 退出（退出是系统手势被占后的兜底出口） */
.brow {
  margin-top: 10px;
  flex-shrink: 0;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.half {
  width: 84px;
  height: 44px;
  margin-top: 0;
}
.quit {
  margin-left: 8px;
  background-color: #3a3a3c;
}
</style>

