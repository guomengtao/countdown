<!-- 首页
     真机 11：设置科目走 pill-shaped 胶囊键盘（待验证），设置昵称走 rect 方键（已验证可用）
     两个输入页布局策略相反，不要「统一」掉：
       - pages/pill     screentype=pill-shaped，键盘立即挂载
       - pages/nickname screentype=rect，延迟 300ms 挂载
     字号只走 ev-six 四档：44/30/28/24 -->
<template>
  <div class="page" onswipe="onSwipe" ontouchstart="onTs" ontouchend="onTe">
    <text class="title">倒数日</text>
    <text class="sub">v{{ ver }}</text>

    <div class="nick-box">
      <text class="nick" if="{{ nick }}">{{ nick }}</text>
      <text class="nick-ph" if="{{ !nick }}">还没设置昵称</text>
    </div>

    <text class="subj" if="{{ subj }}">科目 {{ subj }}</text>
    <text class="subj off" if="{{ !subj }}">科目未设置</text>

    <text class="hint">右划进入科目</text>

    <!-- 主按钮给「设置科目」：当前真机测试主线 -->
    <div class="btn primary" onclick="goPill">
      <text class="btn-t">设置科目</text>
    </div>

    <div class="btn" onclick="goNick">
      <text class="btn-t">设置昵称</text>
    </div>

    <div class="btn" onclick="goDiag">
      <text class="btn-t">诊断信息</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    subj: '',
    tx: 0,
    ty: 0,
    tt: 0,
    navAt: 0
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadAll()
  },

  // 从设置页返回时要重新读一次，否则显示的永远是旧值
  onShow() {
    this.loadAll()
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
    storage.get({
      key: 'cd_subject',
      success: function (d) {
        self.subj = d || ''
      },
      fail: function () {
        self.subj = ''
      }
    })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },

  // 首页右划 = 进入「设置科目」。
  // 注意：左滑是系统官方的「退出」手势，绝不能占用（占了会导致退出失败），
  // 所以这里只用右划，且必须保证右划不会反过来卡住系统手势。
  // 双通道：优先用 Vela 的 onswipe（部分平台/版本不派发），
  // 再兜一层 touch 起止坐标判定，两个通道都命中时用 navAt 去重，避免连开两页。
  onSwipe(evt) {
    const dir = (evt && evt.direction) || ''
    if (dir === 'right') this.goPillOnce()
  },

  onTs(evt) {
    const t = (evt && evt.touches && evt.touches[0]) || {}
    this.tx = t.clientX || t.x || 0
    this.ty = t.clientY || t.y || 0
    this.tt = Date.now()
  },

  onTe(evt) {
    const list = (evt && evt.changedTouches) || (evt && evt.touches) || []
    const t = list[0] || {}
    const dx = (t.clientX || t.x || 0) - this.tx
    const dy = Math.abs((t.clientY || t.y || 0) - this.ty)
    const dt = Date.now() - this.tt
    if (dx > 60 && dy < 60 && dt < 800) this.goPillOnce()
  },

  goPillOnce() {
    const now = Date.now()
    if (this.navAt && now - this.navAt < 800) return
    this.navAt = now
    router.push({ uri: '/pages/pill' })
  },

  goPill() {
    router.push({ uri: '/pages/pill' })
  },

  goDiag() {
    router.push({ uri: '/pages/diag' })
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding-top: 10px;
}

.title {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  color: #ffffff;
}

.sub {
  font-size: 24px;
  line-height: 34px;
  color: #6e6e73;
}

.nick-box {
  width: 176px;
  height: 56px;
  margin-top: 16px;
  justify-content: center;
  align-items: center;
  border-radius: 12px;
  background-color: #1c1c1e;
}

.nick {
  font-size: 30px;
  line-height: 40px;
  color: #ffffff;
  lines: 1;
}

.nick-ph {
  font-size: 24px;
  line-height: 34px;
  color: #8e8e93;
}

.subj {
  margin-top: 8px;
  font-size: 24px;
  line-height: 30px;
  color: #ffffff;
  flex-shrink: 0;
}
.subj.off {
  color: #8e8e93;
}

/* 手势提示：只是一句小字，不占点击热区 */
.hint {
  margin-top: 2px;
  font-size: 24px;
  line-height: 30px;
  color: #6e6e73;
  flex-shrink: 0;
}

.btn {
  width: 176px;
  height: 48px;
  margin-top: 10px;
  border-radius: 24px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}

.primary {
  background-color: #0a84ff;
  margin-top: 18px;
}

.btn-t {
  font-size: 28px;
  line-height: 38px;
  color: #ffffff;
}
</style>
