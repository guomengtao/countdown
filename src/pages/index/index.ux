<!-- 首页
     真机 11：设置科目走 pill-shaped 胶囊键盘（待验证），设置昵称走 rect 方键（已验证可用）
     两个输入页布局策略相反，不要「统一」掉：
       - pages/pill     screentype=pill-shaped，键盘立即挂载
       - pages/nickname screentype=rect，延迟 300ms 挂载
     字号只走 ev-six 四档：44/30/28/24 -->
<template>
  <!-- v0.0.115：根节点接管触摸流。
       之前的结论「根节点碰 touch 就吃掉右划退出」是对的，所以这一版
       干脆不再依赖系统右划 —— 自己判断右划并 quitApp()，出口等价。
       左滑的反馈改为「一滑就出」：位移刚过 16px 就变蓝 + 震动，
       松手且位移仍够才进入（用户明确要求：滑一半停住要有反应，
       滑完再提示没意义）。 -->
  <div class="page" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd" ontouchcancel="onTouchEnd">
    <!-- 触摸由 .page 根节点统一接管（见 script 里 onTouchStart 注释）。
         这里的 onswipe 保留为兜底通道，逐块挂是因为 Vela 的 swipe 不冒泡 -->
    <div class="mid" onswipe="onSwipe">
      <!-- v0.0.114：每个子块都单独挂 onswipe。
           Vela 的 swipe 事件不冒泡到父容器 —— 只挂 .mid 时，手指落在
           「倒数日」「还没设置昵称」这些 text 上完全收不到事件，
           只有落在提示行（div 包 text）才有反应。所以逐块挂 -->
      <text class="title" onswipe="onSwipe">倒数日</text>
      <text class="sub" onswipe="onSwipe">v{{ ver }}</text>

      <div class="nick-box" onswipe="onSwipe">
        <text class="nick" if="{{ nick }}" onswipe="onSwipe">{{ nick }}</text>
        <text class="nick-ph" if="{{ !nick }}" onswipe="onSwipe">还没设置昵称</text>
      </div>

      <text class="subj" if="{{ subj }}" onswipe="onSwipe">科目 {{ subj }}</text>
      <text class="subj off" if="{{ !subj }}" onswipe="onSwipe">科目未设置</text>

      <!-- 左滑提示：静态箭头 + 文字。
           刻意不挂 touch 监听做「跟手箭头」——Vela 上页面注册 touch 会把系统
           「右划退出」手势吃掉（2026-11-02 实证，v0.0.103 之前一直退不出去）。
           v0.0.113：左滑被识别时，这一行立刻换成蓝色「已识别左滑」，
           让用户看见手势有反应，随后进入科目页。只换文案，不做动画/位移。 -->
      <div class="hint">
        <image class="hint-ic" src="/common/icons/chevron-left-light.png" if="{{ !swiped }}"></image>
        <text class="hint-t" if="{{ !swiped }}">左滑进入科目</text>
        <text class="hint-t on" if="{{ swiped }}">正在进入科目</text>
      </div>
    </div>

    <!-- 主按钮给「设置科目」：当前真机测试主线 -->
    <div class="btn primary" onclick="goPill">
      <text class="btn-t">设置科目</text>
    </div>

    <div class="btn" onclick="goNick">
      <text class="btn-t">设置昵称</text>
    </div>

    <!-- 底部并排：诊断 + 退出。退出是兜底动作 —— 只要本应用在手势上占过位，
         系统的右划退出就可能失效，必须给用户一个明确的出口 -->
    <div class="brow">
      <div class="btn half" onclick="goDiag">
        <text class="btn-t">诊断</text>
      </div>
      <div class="btn half quit" onclick="quitApp">
        <text class="btn-t">退出</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    subj: '',
    tx: 0,
    ty: 0,
    tt: 0,
    navAt: 0,
    lx: 0,
    armed: false,
    swiped: false
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadAll()
  },

  // 从设置页返回时要重新读一次，否则显示的永远是旧值
  onShow() {
    this.swiped = false
    this.loadAll()
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
    storage.get({
      key: 'cd_subject',
      success: function (d) {
        self.subj = d || ''
      },
      fail: function () {
        self.subj = ''
      }
    })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },

  // ── 左滑：一滑就有反馈（v0.0.115）────────────────────────────
  // 为什么不用 onswipe：onswipe 是「拖够阈值、已经滑完」才派发一次，
  // 那时候页面马上就要翻走，变色根本看不见（用户原话：没意义）。
  // 所以改用 touch 三件套，在位移刚过 16px 的瞬间就给反馈。
  //
  // ⚠️ 三条红线（前几次翻车的教训）：
  //   1) touchmove 里绝不做逐帧 setData —— 一次越过阈值只切一次状态，
  //      用 this.armed 上锁（v0.0.113/114 逐帧刷 opacity，真机直接退应用）
  //   2) 不写 opacity / transform / 位移，只换一行文字的颜色（不触发重排）
  //   3) 根节点接住触摸流后系统右划失效，所以右划必须自己处理（onTouchEnd）
  onTouchStart(evt) {
    const t = (evt && evt.touches && evt.touches[0]) || null
    if (!t) return
    this.tx = t.clientX
    this.ty = t.clientY
    this.lx = t.clientX
    this.armed = false
  },

  onTouchMove(evt) {
    const t = (evt && evt.touches && evt.touches[0]) || null
    if (!t) return
    this.lx = t.clientX
    if (this.armed) return

    const dx = t.clientX - this.tx
    const dy = t.clientY - this.ty
    // 左移 16px 且没有明显上下漂移 = 认定「开始左滑」
    if (dx <= -16 && Math.abs(dy) < 40) {
      this.armed = true
      this.swiped = true      // 唯一一次 setData：提示行变蓝
      this.buzz()             // 唯一一次震动：手环上比颜色更即时
    }
  },

  onTouchEnd() {
    const dx = this.lx - this.tx
    const armed = this.armed
    this.armed = false

    // 右划：系统手势已被本页吃掉，这里等价兜底（超过 60px 才算数，避免误触）
    if (dx >= 60) {
      this.swiped = false
      this.quitApp()
      return
    }

    // 松手时位移仍够才算数：滑到一半放弃 → 只把颜色复位，不跳页
    if (armed && dx <= -30) {
      const self = this
      setTimeout(function () {
        self.swiped = false
        self.enterPill()
      }, 120)
    } else {
      this.swiped = false
    }
  },

  // 震动：函数内 require（顶层 import 在某镜像上会把整页带崩，见 class-schedule 踩坑）
  buzz() {
    try {
      const vibrator = require('@system.vibrator')
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
  },

  // onswipe 兜底：万一某镜像不派发 touch 事件，老路径还能进
  onSwipe(evt) {
    const dir = (evt && evt.direction) || ''
    if (dir === 'left') this.enterPill()
  },

  // 统一入口：800ms 内只进一次，避免 touch 与 onswipe 双触发连开两页
  enterPill() {
    const now = Date.now()
    if (this.navAt && now - this.navAt < 800) return
    this.navAt = now
    try {
      router.push({ uri: '/pages/pill' })
    } catch (e) {}
  },

  goPill() {
    router.push({ uri: '/pages/pill' })
  },

  goDiag() {
    router.push({ uri: '/pages/diag' })
  },

  // 退出兜底：优先 app.terminate()（手环上等于退出应用），
  // 万一该 API 在当前镜像不可用，退回 router.back()，两种都试一遍不阻塞 UI
  quitApp() {
    try {
      app.terminate()
    } catch (e) {}
    setTimeout(function () {
      try {
        router.back()
      } catch (e) {}
    }, 80)
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding-top: 10px;
}

.title {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  color: #ffffff;
}

.sub {
  font-size: 24px;
  line-height: 34px;
  color: #6e6e73;
}

.nick-box {
  width: 176px;
  height: 56px;
  margin-top: 16px;
  justify-content: center;
  align-items: center;
  border-radius: 12px;
  background-color: #1c1c1e;
}

.nick {
  font-size: 30px;
  line-height: 40px;
  color: #ffffff;
  lines: 1;
}

.nick-ph {
  font-size: 24px;
  line-height: 34px;
  color: #8e8e93;
}

.subj {
  margin-top: 8px;
  font-size: 24px;
  line-height: 30px;
  color: #ffffff;
  flex-shrink: 0;
}
.subj.off {
  color: #8e8e93;
}

/* 手势提示：只是一句小字，不占点击热区 */
/* 左滑提示行：箭头 + 文字，一行居中。纯静态，不参与任何手势 */
.hint {
  margin-top: 2px;
  flex-shrink: 0;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hint-ic {
  width: 20px;
  height: 20px;
  margin-right: 2px;
  opacity: 0.5;
}
.hint-t {
  font-size: 24px;
  line-height: 30px;
  color: #6e6e73;
}
/* 左滑被识别时的高亮文案：只换颜色，不改尺寸/位置，避免重排 */
.hint-t.on {
  color: #0a84ff;
}

.btn {
  width: 176px;
  height: 48px;
  margin-top: 10px;
  border-radius: 24px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}

.primary {
  background-color: #0a84ff;
  margin-top: 18px;
}

.btn-t {
  font-size: 28px;
  line-height: 38px;
  color: #ffffff;
}
/* 手势区：只包住标题/版本/昵称/科目/提示这块，不铺满整屏 */
.mid {
  width: 100%;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
}

/* 底部并排两个小按钮：诊断 + 退出（退出是系统手势被占后的兜底出口） */
.brow {
  margin-top: 10px;
  flex-shrink: 0;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.half {
  width: 84px;
  height: 44px;
  margin-top: 0;
}
.quit {
  margin-left: 8px;
  background-color: #3a3a3c;
}
</style>

