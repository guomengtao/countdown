<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<!-- 设置科目页（2026-11-01 晚，v0.0.71 真机排查版）
     目录名 pages/pill 是历史遗留（最初叫「胶囊键盘」验证页），实际功能已是「设置科目」。

     【真机 11 实测反馈】页头/诊断/输入框/保存都显示，唯独键盘不出来，且不崩溃。
     模拟器同尺寸 212×520 能出键盘 → 怀疑真机上 ime-host 的高度算不出来：
     组件内部键盘是 position:absolute;bottom:0，父级高度为 0 或不足时键盘被排到看不见的位置。

     本版做「四档容器」实验，一次安装测四个假设：点顶部数字按钮 1→2→3→4 循环。
       h1 = 250px（原来 min-height 的值，几乎等于没高度）
       h2 = 330px
       h3 = 400px（接近整屏，够放全套键盘）
       h4 = 绝对定位铺满整屏（不依赖 flex 计算，键盘一定贴在屏幕底；头部用 z-index 浮在上面）
     哪个档位出键盘，就把那个容器写法定死。min-height 在 Vela 的 flex 子项上可能不生效，
     所以 1-3 档全部用固定 height，4 档直接给 absolute 全屏。

     两条沿用约束（与 nickname 页相反，不要「统一」掉）：
     1. screentype 必须 "pill-shaped"
     2. 键盘必须【立即挂载】：pill 分支延迟挂载会整块不渲染
     nickname 页用 rect + 延迟 300ms，两者策略不同，别互相抄 -->

<template>
  <div class="page">
    <!-- 顶部只放返回胶囊，真正水平居中。
         之前档位按钮挤在这里，212 宽下 140+8+40=188，而 y=40 处胶囊屏可用宽度
         只有 23~189（弧半径 106），按钮右缘被弧边切掉，热区也不到 40 -->
    <div class="top">
      <!-- 返回键与标题合并成一个居中胶囊按钮，整块可点返回。
           图标用 lucide chevron-left 的 PNG 双版本（深色界面用 light 白描边，
           浅色界面换 dark 黑描边），不用 icon font，避免手环缺字形 -->
      <div class="hd" onclick="goBack">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t">设置科目</text>
      </div>
    </div>

    <!-- 分辨率/屏宽行已删（2026-11-02）：490 屏上这 26px 是键盘能不能整块出来的关键，
         屏宽×屏高改到「诊断信息」页看，设置页把高度全留给键盘 -->

    <!-- 档位按钮条（仅真机测试期使用）：4 个按钮各自对应一档，点哪个进哪档，
         一次装机就能把四种容器高度全试完，不必循环点。
         位于 y≈90，胶囊屏此处已接近矩形段（可用 2~210），4×44+3×6=194 居中不切边 -->
    <div class="mbar">
      <div class="{{ m1 }}" onclick="setMode1"><text class="mb-t">1</text></div>
      <div class="{{ m2 }}" onclick="setMode2"><text class="mb-t">2</text></div>
      <div class="{{ m3 }}" onclick="setMode3"><text class="mb-t">3</text></div>
      <div class="{{ m4 }}" onclick="setMode4"><text class="mb-t">4</text></div>
    </div>

    <div class="row2">
      <div class="disp">
        <text class="txt" if="{{ text.length }}">{{ text }}</text>
        <text class="ph" if="{{ !text.length }}">输入科目</text>
      </div>
      <div class="ok" onclick="save">
        <text class="ok-t">保存</text>
      </div>
    </div>

    <div class="ime-host {{ cls }}" style="{{ imeStyle }}">
      <input-method
        hide="{{ false }}"
        keyboardtype="QWERTY"
        maxlength="5"
        vibratemode="short"
        screentype="pill-shaped"
        oncomplete="onChar"
        ondelete="onDel"
      ></input-method>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import device from '@system.device'

const probe = require('../../common/probe.js')

const HEIGHTS = ['250', '330', '400', '全屏']

export default {
  data: {
    text: '',
    diag: '',
    mode: 4,
    cls: 'h4',
    m1: 'mb0',
    m2: 'mb0',
    m3: 'mb0',
    m4: 'mb1',
    sw: 0,
    sh: 0,
    imeStyle: 'height:336px'
  },

  onInit() {
    probe.mark('subject', 'enter')
    const self = this
    storage.get({
      key: 'cd_subject',
      success: function (d) {
        if (d) self.text = d
      },
      fail: function () {}
    })
  },

  onReady() {
    probe.mark('subject', 'shown')
    const self = this
    device.getInfo({
      success: function (d) {
        self.sw = d.screenWidth || 0
        self.sh = d.screenHeight || 0
        self.refresh()
      },
      fail: function () {
        self.diag = '取屏信息失败'
      }
    })
  },

  refresh() {
    this.diag = this.sw + '×' + this.sh
    this.applyH()
  },

  // 键盘高度按屏幕实际高度算，不再写死：
  // 手环 11/10 是 520 高 → 520-184=336；手环 9 是 490 高 → 306。
  // 写死 336 在 490 上会让键盘顶到输入框（键盘 top=154 < 输入框底 180）。
  applyH() {
    const base = { 1: 250, 2: 330, 3: 400, 4: 9999 }
    // 154 = 顶部胶囊(12+48) + 档位行(2+46) + 输入行(2+44)；留 4px 间隙
    const maxH = (this.sh ? this.sh : 520) - 158
    let h = base[this.mode]
    if (!h || h > maxH) h = maxH
    this.imeStyle = 'height:' + h + 'px'
  },

  // 4 个按钮各自直连一档：点哪个进哪档，不需要循环
  setMode(n) {
    this.mode = n
    this.cls = 'h' + n
    this.m1 = n === 1 ? 'mb1' : 'mb0'
    this.m2 = n === 2 ? 'mb1' : 'mb0'
    this.m3 = n === 3 ? 'mb1' : 'mb0'
    this.m4 = n === 4 ? 'mb1' : 'mb0'
    this.applyH()
    probe.mark('subject', 'mode' + n)
  },

  setMode1() { this.setMode(1) },
  setMode2() { this.setMode(2) },
  setMode3() { this.setMode(3) },
  setMode4() { this.setMode(4) },

  onChar(evt) {
    const c = (evt && evt.detail && evt.detail.content) || ''
    if (!c) return
    this.text = (this.text + c).slice(0, 5)
  },

  onDel() {
    this.text = this.text.length ? this.text.slice(0, this.text.length - 1) : ''
  },

  save() {
    const self = this
    storage.set({
      key: 'cd_subject',
      value: this.text || '',
      success: function () {
        probe.mark('subject', 'done')
        router.back()
      },
      fail: function () {
        self.text = '保存失败'
      }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}
/* 顶部行：居中返回胶囊 + 右侧档位按钮。整行 flex-shrink:0，
   否则键盘撑高后被压成 0 高，按钮会「消失」 */
.top {
  z-index: 10;
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
/* 热区下限按 48×48 走：手环手指点击比手机粗，40 高实测点不准 */
.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  background-color: #3a3a3c;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 28px;
  color: #ffffff;
  lines: 1;
}
/* 档位按钮条：4 个按钮并排，点哪个进哪档。
   总宽 4×44 + 3×6 = 194，212 屏居中后 x∈[9,203]，y≈90 处可用 2~210，不切边。
   选中态橙色（和蓝色「保存」区分），未选中深灰，一眼看出当前档位 */
.mbar {
  z-index: 10;
  height: 46px;
  flex-shrink: 0;
  margin-top: 2px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
/* 必须用「单类名」而不是 .mb.on 复合选择器：
   实测 Vela 会把 .mb.on 宽松匹配到所有带 .mb 的元素，导致 4 个按钮全橙 */
.mb0 {
  width: 42px;
  height: 46px;
  margin-left: 3px;
  border-radius: 14px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}
.mb1 {
  width: 42px;
  height: 46px;
  margin-left: 3px;
  border-radius: 14px;
  background-color: #ff9f0a;
  justify-content: center;
  align-items: center;
}
.mb-t {
  font-size: 28px;
  color: #ffffff;
  lines: 1;
}
/* 输入框与保存并排，省下一整行高度留给键盘 */
.row2 {
  z-index: 10;
  margin-top: 2px;
  flex-shrink: 0;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.disp {
  width: 100px;
  height: 44px;
  justify-content: center;
  align-items: center;
  background-color: #1c1c1e;
  border-radius: 12px;
}
.txt {
  font-size: 30px;
  color: #ffffff;
  lines: 1;
}
.ph {
  font-size: 24px;
  color: #8e8e93;
}
.ok {
  width: 76px;
  height: 44px;
  margin-left: 6px;
  justify-content: center;
  align-items: center;
  background-color: #0a84ff;
  border-radius: 20px;
}
.ok-t {
  font-size: 24px;
  color: #ffffff;
}
/* 键盘宿主：四档统一「贴底绝对定位 + 内联高度」。
   组件内部键盘是 position:absolute;bottom:0，父级必须给出确定高度，
   min-height / flex:1 在 Vela 的 flex 子项上算不出高度，键盘会被排到看不见的地方。
   踩坑（2026-11-01 真机）：曾用 left/top:0 + width/height:100% 铺满整屏，
   而 Vela 真机上 z-index 拦不住它，返回胶囊/档位按钮/输入框/保存
   四个热区全部点不动（点到的都是这层空容器）。所以只盖键盘那块地，
   高度 = 屏高 - 184（顶部占位），由 applyH() 按真机屏高算，不写死。 */
.ime-host {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
}
</style>
