<!-- 设置页（2026-11-02 v0.0.120 新建）
     入口：首页「上滑」「长按」。
     定位：手势总入口 / 功能索引页，将来新功能都往这里挂。
     页头与 pill、nickname 两页同构（160×48 居中胶囊），不要各写一套。
     字号只走 ev-six 四档：44 / 30 / 28 / 24 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="top">
      <div class="hd" onclick="goBack" style="background-color: {{ theme.cardLight }}">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t" style="color: {{ theme.text }}">设置</text>
      </div>
    </div>

    <div class="list">
      <!-- 倒数日排第一：它是本应用的主功能，不是配置项；
           放在这里是因为设置页是所有页面的索引，位置固定好找 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="goCdList">
        <text class="it-k" style="color: {{ theme.text }}">倒数日</text>
        <text class="it-v">打开</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goTheme">
        <text class="it-k" style="color: {{ theme.text }}">主题</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ themeName }}</text>
      </div>
      <!-- 列表版式：点击直接切换（只有两个值，不需要子页面）。
           存 storage key cd_layout，cd-list 在 onShow/onInit 读取 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="toggleLayout">
        <text class="it-k" style="color: {{ theme.text }}">版式</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ layoutName }}</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goNick">
        <text class="it-k" style="color: {{ theme.text }}">昵称</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ nick }}">{{ nick }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ !nick }}">未设置</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goPill">
        <text class="it-k" style="color: {{ theme.text }}">科目</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ subj }}">{{ subj }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ !subj }}">未设置</text>
      </div>
      <!-- 手势页入口：v0.3.0 首页顶部不再是可点胶囊，手势中心从这里进 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="goGesture">
        <text class="it-k" style="color: {{ theme.text }}">手势</text>
        <text class="it-v">打开</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goDiag">
        <text class="it-k" style="color: {{ theme.text }}">诊断</text>
        <text class="it-v">打开</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="quitApp">
        <text class="it-k" style="color: {{ theme.text }}">退出</text>
        <text class="it-v">关闭</text>
      </div>
    </div>

    <text class="ver" style="color: {{ theme.textMuted }}">v{{ ver }}</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'
import theme from '../../data/theme.js'

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    subj: '',
    themeName: '经典黑',
    layout: 'card',
    layoutName: '标准',
    theme: {}
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadTheme()
    this.loadLayout()
    this.loadAll()
  },

  onShow() {
    // 从主题页返回要重读：否则条目上还显示旧主题名
    this.loadTheme()
    this.loadLayout()
    this.loadAll()
  },

  loadLayout() {
    const self = this
    storage.get({
      key: 'cd_layout',
      success: function (v) { self.applyLayout(v) },
      fail: function () { self.applyLayout('card') }
    })
  },

  applyLayout(v) {
    this.layout = (v === 'hero') ? 'hero' : 'card'
    // 值只给 2-3 字：24px 下「列表样式」+「标准卡」= 168px 已顶满 168px 行内宽，
    // 实测会折成两行（2026-11-02 版面还原图），所以键名压到「版式」、值压到「标准/大字」
    this.layoutName = (this.layout === 'hero') ? '大字' : '标准'
  },

  toggleLayout() {
    const self = this
    const next = this.layout === 'hero' ? 'card' : 'hero'
    storage.set({
      key: 'cd_layout',
      value: next,
      success: function () { self.applyLayout(next) },
      fail: function () { self.applyLayout(next) }
    })
  },

  loadTheme() {
    const self = this
    theme.getTheme(function (t, name) {
      self.theme = t
      self.themeName = t.name || name
    })
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
    storage.get({
      key: 'cd_subject',
      success: function (d) {
        self.subj = d || ''
      },
      fail: function () {
        self.subj = ''
      }
    })
  },

  goBack() {
    router.back()
  },
  goCdList() {
    router.push({ uri: '/pages/cd-list' })
  },

  goTheme() {
    router.push({ uri: '/pages/theme' })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },
  goPill() {
    router.push({ uri: '/pages/pill' })
  },
  goGesture() {
    router.push({ uri: '/pages/index' })
  },
  goDiag() {
    router.push({ uri: '/pages/diag' })
  },
  quitApp() {
    try {
      app.terminate()
    } catch (e) {}
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

/* 条目行：宽 168 居中（192 屏左右各留 12）。
   8 项 × 48 = 384，加页头 72 与版号 30 = 486 < 490，192×490 屏不出滚动条。
   行高演进：6 项 52/8 → 7 项(加手势) 46/5 → 8 项(加列表样式) 44/4。
   ⚠️ 再加条目就会溢出，届时必须把 .list 换成 scroll 容器。 */
.list {
  width: 168px;
  margin-top: 12px;
  flex-direction: column;
  flex-shrink: 0;
}
.item {
  width: 100%;
  height: 44px;
  margin-bottom: 4px;
  padding-left: 14px;
  padding-right: 12px;
  border-radius: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.it-k {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.it-v {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.ver {
  margin-top: 6px;
  font-size: 24px;
  line-height: 30px;
}
</style>
