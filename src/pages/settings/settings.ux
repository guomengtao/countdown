<!-- 设置页（2026-11-02 v0.0.120 新建）
     入口：首页「上滑」「长按」。
     定位：手势总入口 / 功能索引页，将来新功能都往这里挂。
     页头与 pill、nickname 两页同构（160×48 居中胶囊），不要各写一套。
     字号只走 ev-six 四档：44 / 30 / 28 / 24 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="top">
      <div class="hd" onclick="goBack" style="background-color: {{ theme.cardLight }}">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t" style="color: {{ theme.text }}">设置</text>
      </div>
    </div>

    <div class="list">
      <div class="item" style="background-color: {{ theme.card }}" onclick="goTheme">
        <text class="it-k" style="color: {{ theme.text }}">主题</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ themeName }}</text>
      </div>
      <!-- 清空：低频 + 危险，所以从首页下沉到这里，并且带 3 秒二次确认。
           首页工具行右边那个位置让给「版式」切换（高频轻操作）。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="clearAll">
        <text class="it-k" style="color: {{ clearConfirm ? theme.deleteText : theme.text }}">{{ clearConfirm ? '确认清空' : '清空数据' }}</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goNick">
        <text class="it-k" style="color: {{ theme.text }}">昵称</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ nick }}">{{ nick }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ !nick }}">未设置</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goPill">
        <text class="it-k" style="color: {{ theme.text }}">科目</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ subj }}">{{ subj }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ !subj }}">未设置</text>
      </div>
      <!-- 手势页入口：v0.3.0 首页顶部不再是可点胶囊，手势中心从这里进 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="goGesture">
        <text class="it-k" style="color: {{ theme.text }}">手势</text>
        <text class="it-v">打开</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goDiag">
        <text class="it-k" style="color: {{ theme.text }}">诊断</text>
        <text class="it-v">打开</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="quitApp">
        <text class="it-k" style="color: {{ theme.text }}">退出</text>
        <text class="it-v">关闭</text>
      </div>
    </div>

    <text class="ver" style="color: {{ theme.textMuted }}">v{{ ver }}</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'
import theme from '../../data/theme.js'
import countdown from '../../data/countdown.js'

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    subj: '',
    themeName: '经典黑',
    clearConfirm: false,
    clearTimer: null,
    theme: {}
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadTheme()
    this.loadAll()
  },

  onShow() {
    // 从主题页返回要重读：否则条目上还显示旧主题名
    this.loadTheme()
    this.loadAll()
  },

  // 清空全部：3 秒内再点一次才真删（与首页旧逻辑同一口径）
  clearAll() {
    const self = this
    if (this.clearConfirm) {
      countdown.save([], function () {
        self.clearConfirm = false
      })
      if (this.clearTimer) {
        clearTimeout(this.clearTimer)
        this.clearTimer = null
      }
      return
    }
    this.clearConfirm = true
    if (this.clearTimer) clearTimeout(this.clearTimer)
    this.clearTimer = setTimeout(function () {
      self.clearConfirm = false
      self.clearTimer = null
    }, 3000)
  },

  loadTheme() {
    const self = this
    theme.getTheme(function (t, name) {
      self.theme = t
      self.themeName = t.name || name
    })
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
    storage.get({
      key: 'cd_subject',
      success: function (d) {
        self.subj = d || ''
      },
      fail: function () {
        self.subj = ''
      }
    })
  },

  goBack() {
    router.back()
  },
  goTheme() {
    router.push({ uri: '/pages/theme' })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },
  goPill() {
    router.push({ uri: '/pages/pill' })
  },
  goGesture() {
    router.push({ uri: '/pages/index' })
  },
  goDiag() {
    router.push({ uri: '/pages/diag' })
  },
  quitApp() {
    try {
      app.terminate()
    } catch (e) {}
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

/* 条目行：宽 168 居中（192 屏左右各留 12）。
   7 项 × 54 = 378，加页头 72 与版号 30 = 480 < 490，192×490 屏不出滚动条。
   演变：6 项 52/8 → 8 项 44/4 → 删掉冗余「倒数日」后回到 7 项，放宽到 48/6。
   ⚠️ 再加到 9 项就会溢出，届时必须把 .list 换成 scroll 容器
   （参照 theme.ux：scroll 要同时有 flex-direction:column 与确定高度）。 */
.list {
  width: 168px;
  margin-top: 12px;
  flex-direction: column;
  flex-shrink: 0;
}
.item {
  width: 100%;
  height: 48px;
  margin-bottom: 6px;
  padding-left: 14px;
  padding-right: 12px;
  border-radius: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.it-k {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.it-v {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.ver {
  margin-top: 6px;
  font-size: 24px;
  line-height: 30px;
}
</style>
