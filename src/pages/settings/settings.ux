<!-- 设置页（2026-11-02 v0.0.120 新建）
     入口：首页「设置」按钮（屏幕坐标 155,428）。手势上滑会触发手环应用切换，别用。
     定位：功能索引页，将来新功能都往这里挂。
     页头与 pill、nickname 两页同构（160×48 居中胶囊），不要各写一套。
     字号只走 ev-six 四档：44 / 30 / 28 / 24
     2026-11-14 多语言试点：静态文案走 $t，词表见 src/i18n/，长度规则见总纲 §3.21 第 9 条。

     2026-11-14 装机实测后的版式纠正（evtask-D-guomengtao-261114-kpkmaw）：
     「主题」行原来是「主题」标签 + 主题名双列，.item 内容宽仅 142px@24px = 4.44P，
     而中文「主题+经典黑」=5.00P、「主题+墨绿护眼」=6.00P，英文 Theme+Violet=6.05P，
     双列根本放不下——这是页面自身违反 ev-six，不是翻译问题。
     按用户裁定：先纠正版式再谈翻译。改为单值行（只显示当前主题名），
     中文 4P / 英文 3.3P 均进线；禁止靠缩字号或截断来硬塞。
     屏高核算：6 项 × 54 = 324，+ 页头 60 + margin 12 + 版号 36 = 432 < 490，仍不出滚动条。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="top">
      <div class="hd" onclick="goBack" style="background-color: {{ theme.cardLight }}">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t" style="color: {{ theme.text }}">{{ t.settings.title }}</text>
      </div>
    </div>

    <div class="list">
      <!-- 主题：单值行。去掉左侧「主题」标签是为了腾出 2P——双列时每列只剩 2.2P，
           连 3 字中文主题名都放不下。点击仍进主题页，语义由「当前值可点」承担。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="goTheme">
        <!-- 2026-11-15：11 条 $t 字面量分支合并成一条。主题名由 loadTheme 在脚本里查字典后
             作为 themeName 字符串下发，模板侧不再拼 key（动态 key 会崩，pit-20261115-190）。 -->
        <text class="it-k" style="color: {{ theme.text }}">{{ themeName }}</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goNick">
        <text class="it-k" style="color: {{ theme.text }}">{{ t.settings.nickname }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ nick }}">{{ nick }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ !nick }}">{{ t.settings.unset }}</text>
      </div>
      <!-- 语言：点一下按 自动 → 中文 → EN → 自动 循环。
           存完整 locale 字符串（不是布尔），将来加日语只需扩 LOCALES 数组，
           不需要改页面结构——见根仓 docs/手环多语言资源结构与日语扩展规划-20261114.md。
           值的可读文案固定为 Auto / 中文 / EN（三种界面语言下都不超 4.44P）。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="cycleLocale">
        <text class="it-k" style="color: {{ theme.text }}">{{ t.settings.language }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ localeLabel }}</text>
      </div>
      <!-- 2026-11-02 发布前清理：删掉「科目」与「手势」两项。
           它们是从课程表项目带过来的遗留入口——「科目」跳 pages/pill（键盘宿主测试页）、
           「手势」跳 pages/index（701 行旧首页，根节点自绘 touch，正是会闪退的写法）。
           倒数日没有「科目」概念，手势也不该把用户丢进一个旧页面，两项一并下掉。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="goDiag">
        <text class="it-k" style="color: {{ theme.text }}">{{ t.settings.diag }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ t.settings.open }}</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="quitApp">
        <text class="it-k" style="color: {{ theme.text }}">{{ t.settings.exit }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ t.settings.close }}</text>
      </div>

      <!-- 清空数据放最后一项（2026-11-02 用户要求）：
           危险操作脱离了视线最高处（原来排第 2，紧跟主题之后），
           也符合「越靠下越不可逆」的列表惯例。仍带 3 秒二次确认。
           2026-11-14：原来的三元 + 中文硬编码改成两个 if + $t，避免模板里同时出现表达式与翻译调用。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="clearAll">
        <text class="it-k" if="{{ clearConfirm }}" style="color: {{ theme.deleteText }}">{{ t.settings.clearConfirm }}</text>
        <text class="it-k" if="{{ !clearConfirm }}" style="color: {{ theme.text }}">{{ t.settings.clear }}</text>
      </div>
    </div>

    <text class="ver" style="color: {{ theme.textMuted }}">v{{ ver }}</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'
import theme from '../../data/theme.js'
import countdown from '../../data/countdown.js'
const probe = require('../../common/probe.js')
const I18N = require('../../common/i18n.js')

/* 「清空数据」的三秒确认窗口用**模块级变量**记，不用 this / data。
 *
 * 依据（2026-11-03 探针实测）：两次相隔 0.7s 的点击都进了「第一次」分支
 * （日志 c1-entry → c3-armed 重复两轮）——this 上的写入不跨事件保留；
 * 改模块级变量后同样两轮都进 arm 分支，说明模块上下文也不跨事件共享。
 * 因此确认标记只能落 storage：它是这里唯一跨事件可靠共享的介质。 */
const ARM_KEY = 'cd_clear_arm'
let armTimer = null

/* 语言：与 app.ux 共用同一个 storage key，改动必须两边同步。
 * 存完整 locale 字符串（auto / zh-CN / en），不用布尔「是否英文」——
 * 加日语、繁体时只扩数组，不改调用方，避免返工。 */
const LOCALE_KEY = 'cd_locale'
const LOCALES = ['auto', 'zh-CN', 'en', 'ja-JP']

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    themeKey: 'classic',
    clearConfirm: false,
    theme: {},
    locale: 'auto',
    localeLabel: 'Auto',
    // 自建词表：模板只用 t.settings.xxx 取字面量属性，不拼 key
    t: I18N.getT('zh'),
    // 主题名在脚本里查好后下发，模板单值渲染（替代原 11 条 if 分支）
    themeName: ''
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadTheme()
    this.loadAll()
    this.loadLocale()
  },

  onShow() {
    // 从主题页返回要重读：否则条目上还显示旧主题名
    this.loadTheme()
    this.loadAll()
  },

  // 清空全部：3 秒内再点一次才真删（与首页旧逻辑同一口径）
  clearAll() {
    const self = this
    const now = Date.now()
    function arm() {
      storage.set({ key: ARM_KEY, value: String(now) })
      self.clearConfirm = true
      if (armTimer) clearTimeout(armTimer)
      armTimer = setTimeout(function () {
        self.clearConfirm = false
        armTimer = null
      }, 3000)
    }
    storage.get({
      key: ARM_KEY,
      success: function (v) {
        const at = parseInt(v, 10) || 0
        if (at && now - at < 3000) {
          storage.delete({ key: ARM_KEY })
          countdown.save([], function () {
            router.back()
          })
          return
        }
        arm()
      },
      fail: function () {
        arm()
      }
    })
  },

  loadTheme() {
    const self = this
    // theme.getTheme 回调第二参数就是主题 key（如 classic）。
    // 2026-11-15 改自建 t：主题名在**脚本**里从自造字典查（I18N.DICT[lang].theme[key]），
    // 不再依赖 this.$t（脚本作用域取不到词条，pit-20261115-190），也不用模板拼 key。
    theme.getTheme(function (t, key) {
      self.theme = t
      const k = key || 'classic'
      self.themeKey = k
      const names = self.t && self.t.theme
      self.themeName = (names && names[k]) || t.name || k
    })
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
  },

  // 值的可读文案：三种界面语言下都用同一组短标识，避免「English」这种 7 字母值超宽。
  labelOf(v) {
    if (v === 'zh-CN') return '中文'
    if (v === 'en') return 'EN'
    if (v === 'ja-JP') return '日本語'
    return 'Auto'
  },

  loadLocale() {
    const self = this
    storage.get({
      key: LOCALE_KEY,
      success: function (v) {
        const val = LOCALES.indexOf(v) >= 0 ? v : 'auto'
        self.locale = val
        self.localeLabel = self.labelOf(val)
        self.applyLang(val)
      },
      fail: function () {
        self.locale = 'auto'
        self.localeLabel = 'Auto'
        self.applyLang('auto')
      }
    })
  },

  // 自建 t 的落地点：算出目标语言 → 换字典 → 主题名重算。
  // 只改 data，模板自动重算，**不需要** router.replace 重建页面。
  applyLang(pref) {
    let sysLang = 'zh'
    try {
      const configuration = require('@system.configuration')
      const loc = configuration.getLocale()
      if (loc && loc.language) sysLang = String(loc.language)
    } catch (e) {}
    const lang = I18N.langFromPref(pref, sysLang)
    this.t = I18N.getT(lang)
    const names = this.t.theme
    this.themeName = (names && names[this.themeKey]) || this.themeName
    probe.mark('locale', 'lang', pref + '>' + lang)
  },

  cycleLocale() {
    const self = this
    const i = LOCALES.indexOf(this.locale)
    const next = LOCALES[(i + 1) % LOCALES.length]
    this.locale = next
    this.localeLabel = this.labelOf(next)
    // 先换文案（立即生效，不等 storage 回调），再落盘
    this.applyLang(next)
    storage.set({ key: LOCALE_KEY, value: next })
  },

  applyLocale(v) {
    try {
      const configuration = require('@system.configuration')
      const before = this.langOf(configuration.getLocale())
      if (v === 'auto') {
        const sys = configuration.getLocale()
        if (sys && sys.language) {
          configuration.setLocale({ language: sys.language, countryOrRegion: sys.countryOrRegion || '' })
        }
      } else {
        const parts = v.split('-')
        configuration.setLocale({ language: parts[0], countryOrRegion: parts[1] || '' })
      }
      // 静默 no-op 不抛异常：只有前后对比才能判读（pit-20261115-189 / -191）
      const after = this.langOf(configuration.getLocale())
      probe.mark('locale', 'tap', v + ' ' + before + '>' + after)
    } catch (e) {
      // 平台不开放 configuration 时降级：仍跟随系统语言，不影响其他功能。
      probe.mark('locale', 'tap', v + ' throw ' + String(e && e.message ? e.message : e))
    }
  },

  langOf(loc) {
    if (!loc) return 'nil'
    return [loc.language, loc.countryOrRegion].filter(function (x) { return !!x }).join('-') || 'nil'
  },

  goBack() {
    router.back()
  },
  goTheme() {
    router.push({ uri: '/pages/theme' })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },
  goDiag() {
    router.push({ uri: '/pages/diag' })
  },
  quitApp() {
    try {
      app.terminate()
    } catch (e) {}
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

/* 条目行：宽 168 居中（192 屏左右各留 12）。
   6 项 × 54 = 324，加页头 60 + margin 12 + 版号 36 = 432 < 490，192×490 屏不出滚动条。
   演变：6 项 52/8 → 8 项 44/4 → 删冗余「倒数日」回到 7 项 48/6 → 主题改单值 + 加语言仍 6 项。
   ⚠️ 再加到 8 项（432+54=486 擦边、含版号已溢出）就必须把 .list 换成 scroll 容器
   （参照 theme.ux：scroll 要同时有 flex-direction:column 与确定高度）。 */
.list {
  width: 168px;
  margin-top: 12px;
  flex-direction: column;
  flex-shrink: 0;
}
.item {
  width: 100%;
  height: 48px;
  margin-bottom: 6px;
  padding-left: 14px;
  padding-right: 12px;
  border-radius: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.it-k {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.it-v {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.ver {
  margin-top: 6px;
  font-size: 24px;
  line-height: 30px;
}
</style>
