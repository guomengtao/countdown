<!-- 设置页（2026-11-02 v0.0.120 新建）
     入口：首页「上滑」「长按」。
     定位：手势总入口 / 功能索引页，将来新功能都往这里挂。
     页头与 pill、nickname 两页同构（160×48 居中胶囊），不要各写一套。
     字号只走 ev-six 四档：44 / 30 / 28 / 24 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="top">
      <div class="hd" onclick="goBack" style="background-color: {{ theme.cardLight }}">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t" style="color: {{ theme.text }}">设置</text>
      </div>
    </div>

    <div class="list">
      <div class="item" style="background-color: {{ theme.card }}" onclick="goTheme">
        <text class="it-k" style="color: {{ theme.text }}">主题</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}">{{ themeName }}</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="goNick">
        <text class="it-k" style="color: {{ theme.text }}">昵称</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ nick }}">{{ nick }}</text>
        <text class="it-v" style="color: {{ theme.textSecondary }}" if="{{ !nick }}">未设置</text>
      </div>
      <!-- 2026-11-02 发布前清理：删掉「科目」与「手势」两项。
           它们是从课程表项目带过来的遗留入口——「科目」跳 pages/pill（键盘宿主测试页）、
           「手势」跳 pages/index（701 行旧首页，根节点自绘 touch，正是会闪退的写法）。
           倒数日没有「科目」概念，手势也不该把用户丢进一个旧页面，两项一并下掉。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="goDiag">
        <text class="it-k" style="color: {{ theme.text }}">诊断</text>
        <text class="it-v">打开</text>
      </div>
      <div class="item" style="background-color: {{ theme.card }}" onclick="quitApp">
        <text class="it-k" style="color: {{ theme.text }}">退出</text>
        <text class="it-v">关闭</text>
      </div>

      <!-- 清空数据放最后一项（2026-11-02 用户要求）：
           危险操作脱离了视线最高处（原来排第 2，紧跟主题之后），
           也符合「越靠下越不可逆」的列表惯例。仍带 3 秒二次确认。 -->
      <div class="item" style="background-color: {{ theme.card }}" onclick="clearAll">
        <text class="it-k" style="color: {{ clearConfirm ? theme.deleteText : theme.text }}">{{ clearConfirm ? '确认清空' : '清空数据' }}</text>
      </div>
    </div>

    <text class="ver" style="color: {{ theme.textMuted }}">v{{ ver }}</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import app from '@system.app'
import theme from '../../data/theme.js'
import countdown from '../../data/countdown.js'

/* 「清空数据」的三秒确认窗口用**模块级变量**记，不用 this / data。
 *
 * 依据（2026-11-03 探针实测）：两次相隔 0.7s 的点击都进了「第一次」分支
 * （日志 c1-entry → c3-armed 重复两轮）——this 上的写入不跨事件保留；
 * 改模块级变量后同样两轮都进 arm 分支，说明模块上下文也不跨事件共享。
 * 因此确认标记只能落 storage：它是这里唯一跨事件可靠共享的介质。 */
const ARM_KEY = 'cd_clear_arm'
let armTimer = null

export default {
  data: {
    ver: '0.0.1',
    nick: '',
    themeName: '经典黑',
    clearConfirm: false,
    theme: {}
  },

  onInit() {
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.ver = info.versionName
    } catch (e) {}
    this.loadTheme()
    this.loadAll()
  },

  onShow() {
    // 从主题页返回要重读：否则条目上还显示旧主题名
    this.loadTheme()
    this.loadAll()
  },

  // 清空全部：3 秒内再点一次才真删（与首页旧逻辑同一口径）
  clearAll() {
    const self = this
    const now = Date.now()
    function arm() {
      storage.set({ key: ARM_KEY, value: String(now) })
      self.clearConfirm = true
      if (armTimer) clearTimeout(armTimer)
      armTimer = setTimeout(function () {
        self.clearConfirm = false
        armTimer = null
      }, 3000)
    }
    storage.get({
      key: ARM_KEY,
      success: function (v) {
        const at = parseInt(v, 10) || 0
        if (at && now - at < 3000) {
          storage.delete({ key: ARM_KEY })
          countdown.save([], function () {
            router.back()
          })
          return
        }
        arm()
      },
      fail: function () {
        arm()
      }
    })
  },

  loadTheme() {
    const self = this
    theme.getTheme(function (t, name) {
      self.theme = t
      self.themeName = t.name || name
    })
  },

  loadAll() {
    const self = this
    storage.get({
      key: 'cd_nick',
      success: function (d) {
        self.nick = d || ''
      },
      fail: function () {
        self.nick = ''
      }
    })
  },

  goBack() {
    router.back()
  },
  goTheme() {
    router.push({ uri: '/pages/theme' })
  },

  goNick() {
    router.push({ uri: '/pages/nickname' })
  },
  goDiag() {
    router.push({ uri: '/pages/diag' })
  },
  quitApp() {
    try {
      app.terminate()
    } catch (e) {}
  }
}
</script>

<style>
/* 字号只走 ev-six 四档：44 / 30 / 28 / 24（行高 60 / 40 / 38 / 34） */
.page {
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

/* 条目行：宽 168 居中（192 屏左右各留 12）。
   7 项 × 54 = 378，加页头 72 与版号 30 = 480 < 490，192×490 屏不出滚动条。
   演变：6 项 52/8 → 8 项 44/4 → 删掉冗余「倒数日」后回到 7 项，放宽到 48/6。
   ⚠️ 再加到 9 项就会溢出，届时必须把 .list 换成 scroll 容器
   （参照 theme.ux：scroll 要同时有 flex-direction:column 与确定高度）。 */
.list {
  width: 168px;
  margin-top: 12px;
  flex-direction: column;
  flex-shrink: 0;
}
.item {
  width: 100%;
  height: 48px;
  margin-bottom: 6px;
  padding-left: 14px;
  padding-right: 12px;
  border-radius: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.it-k {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.it-v {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
.ver {
  margin-top: 6px;
  font-size: 24px;
  line-height: 30px;
}
</style>
