<!-- 主题选择页（0.2.0 新建）
     11 套配色：classic 是本应用原有纯黑，其余 10 套从 ev/class-schedule 复制。
     入口：设置页「主题」条目。
     页头与 pill / nickname / settings / cd-list 同构（居中胶囊），不另写一套。
     字号只走 ev-six 四档：44 / 30 / 28 / 24。
     列表必须可滚动：11 项 × 50px = 550px，远超 192×490 的可视高度，
     靠 scroll-y 滚动，不做分页（分页会让「换主题」变成翻两次的事）。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="top">
      <div class="hd" onclick="goBack" style="background-color: {{ theme.cardLight }}">
        <image class="hd-ic" src="/common/icons/chevron-left-light.png"></image>
        <text class="hd-t" style="color: {{ theme.text }}">主题</text>
      </div>
    </div>

    <scroll class="list" scroll-y="{{true}}">
      <div for="{{ (idx, item) in themes }}" class="row"
           style="background-color: {{ item.card }}; border: {{ item.key === cur ? 2 : 0 }}px solid {{ item.accent }}"
           onclick="pick(item)">
        <!-- 色块用 bg + accent 双层：只给一个色点看不出「浅色主题」，
             双层能同时表达底色和强调色，一眼分得清深/浅。 -->
        <div class="sw" style="{{ item.swatch }}">
          <div class="dot" style="{{ item.dot }}"></div>
        </div>
        <!-- 文字色必须取 item.text（该主题自己的文字色）：
             用 theme.text（当前主题）会让「晨光白/暖阳米」两行变成白字白底，
             看起来像列表底部多出两个空白行（2026-11-02 真机反馈的真因）。 -->
        <text class="nm" style="color: {{ item.text }}">{{ item.name }}</text>
        <!-- 当前项不用「当前」二字（168px 行宽里 4 字名字 96 + 色块 34 + 「当前」48 必折行），
             改成整行 2px 强调色描边，见 .row 的 inline border -->
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import theme from '../../data/theme.js'

export default {
  data: {
    themes: [],
    cur: 'classic',
    theme: {}
  },

  onInit() {
    const self = this
    this.themes = theme.listThemes()
    theme.getTheme(function (t, name) {
      self.theme = t
      self.cur = name
    })
  },

  pick(item) {
    const self = this
    const key = item && item.key
    if (!key || key === this.cur) return
    // 立即刷新：选完必须马上看到整页变色，否则用户会怀疑没生效
    theme.setTheme(key, function (t, name) {
      self.theme = t
      self.cur = name
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* ⚠️ 必须 flex:1，不能 height:100%：
   Vela 里 height:100% 给不出确定尺寸，父级一塌陷，下面 scroll 的 flex:1
   就拿到 0 高度 —— 表现是「点主题进来一片空白」，即 0.2.1/0.3.0 的
   「10 套主题打不开」真实根因（2026-11-02 定位，同日修）。 */
.page {
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 48px;
  flex-shrink: 0;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.hd {
  width: 160px;
  height: 48px;
  border-radius: 24px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.hd-ic {
  width: 22px;
  height: 22px;
  margin-right: 4px;
  object-fit: contain;
}
.hd-t {
  font-size: 30px;
  line-height: 38px;
  lines: 1;
}

/* 列表：宽 168 居中，行高 44 + 间距 6 = 50/行，11 行共 550px 靠滚动。
   192×490 屏 − 上边距 12 − 页头 48 = 约 430px 可视窗口。

   ⚠️ 必须 flex:1，不能写死 height:400px（2026-11-03 修，真机+模拟器实证）：
   写死固定高度的 scroll，**任何滚动位移都会让 vapp 进程直接崩掉**（fb 全黑、
   进程消失）。慢速注入（200ms/步）同样崩，排除注入节奏因素；同实例上
   diag/cd-list 的 scroll（都是 flex:1）滚动完全正常 —— 差别只在固定尺寸。
   对照 cd-list 的 .list-scroll：flex:1 + flex-direction: column，那才是
   Vela scroll 的标准可滚形态。

   教训：早前认为「高度写死是第二重保险」是错的。当时「只看到 1 个主题」的
   真凶是缺 flex-direction: column，与高度无关；用写死高度去补，反而引入了
   更严重的崩溃。缺 column 这行仍会是真凶，保留。 */
.list {
  width: 168px;
  flex: 1;
  margin-top: 8px;
  margin-bottom: 12px;
  flex-direction: column;   /* ← 缺这一行 = 只显示 1 个主题 */
}
.row {
  width: 100%;
  height: 44px;
  margin-bottom: 6px;
  padding-left: 8px;
  padding-right: 10px;
  border-radius: 12px;
  flex-direction: row;
  align-items: center;
}
.sw {
  width: 26px;
  height: 26px;
  border-radius: 13px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
}
.dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}
.nm {
  flex: 1;
  margin-left: 8px;
  margin-right: 4px;
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}
</style>
